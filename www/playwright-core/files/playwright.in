#!/bin/sh
export PLAYWRIGHT_BROWSERS_PATH=%%PREFIX%%/libexec/ms-playwright
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=%%PLATFORM%%
export NODE_PATH=%%PREFIX%%/lib/node_modules
case "$1" in
    *.js) exec %%NODE%% "$@" ;;
    *)    exec %%NODE%% %%PREFIX%%/lib/node_modules/playwright-core/cli.js "$@" ;;
esac
