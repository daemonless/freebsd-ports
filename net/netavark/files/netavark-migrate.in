#!/bin/sh
# netavark-migrate - Migrate a FreeBSD Podman host between CNI and netavark.
# Preflight check, host setup, in-place migration from CNI to netavark, and rollback.
set -eu

INTERFACE_VERSION="2"
INTERFACE_CAPS="host json no-start"

PREFIX="@PREFIX@"
CNI_DIR="${NETAVARK_MIGRATE_CNI_DIR:-${PREFIX}/etc/cni/net.d}"
BEFORE_CNI_DIR="${NETAVARK_MIGRATE_BEFORE_CNI_DIR:-${CNI_DIR}.before-netavark}"
NV_NET_DIR="${NETAVARK_MIGRATE_NV_NET_DIR:-${PREFIX}/etc/containers/networks}"
CONF_DROPIN="${NETAVARK_MIGRATE_DROPIN:-${PREFIX}/etc/containers/containers.conf.d/50-netavark.conf}"
CONTAINERS_CONF_DIR="${NETAVARK_MIGRATE_CONF_DIR:-${PREFIX}/etc/containers}"
DNS_CONF_DROPIN="${NETAVARK_MIGRATE_DNS_DROPIN:-${CONTAINERS_CONF_DIR}/containers.conf.d/50-netavark-dns.conf}"
STATE_DIR="${NETAVARK_MIGRATE_STATE:-/var/db/netavark-migrate}"
CNI_EPAIR_STATE_DIR="${NETAVARK_MIGRATE_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
PF_CONF="${NETAVARK_MIGRATE_PF_CONF:-/etc/pf.conf}"
BEFORE_FJORD_PF="${NETAVARK_MIGRATE_BEFORE_FJORD_PF:-${PF_CONF}.before-fjord}"
SYSCTL_CONF="${NETAVARK_MIGRATE_SYSCTL_CONF:-/etc/sysctl.conf}"
LOADER_CONF="${NETAVARK_MIGRATE_LOADER_CONF:-/boot/loader.conf}"
NETAVARK_BIN="${PREFIX}/libexec/podman/netavark"
AARDVARK_BIN="${PREFIX}/bin/aardvark-dns"
EPAIR_NV_BIN="${PREFIX}/libexec/netavark/epair"
FLUA_BIN="/usr/libexec/flua"
DEFAULT_DNS_BIND_PORT="5300"
PODMAN_CONF_OVERRIDE=""
PODMAN_SOCK="${NETAVARK_MIGRATE_SOCK:-}"

JSON_MODE=0
NO_START=0
JSON_EMITTED=0
HOST_MUTATED=0
JSON_DIR=""
JSON_STATE=""

usage() {
	cat <<'EOF'
Usage: netavark-migrate [check | host | switch | back | version] [--json] [--no-start]

Subcommands:
  check       Preflight only (changes nothing). Print network and container plan.
  host        Configure the host side only (pf.conf anchors, pf load, sysctl,
              loader, and dns_bind_port when needed); changes no networks,
              containers, or backend setting.
  switch      Migrate CNI -> netavark in place (default when no subcommand is given).
  back        Roll back netavark -> CNI using saved state and restored conflists.
  version     Print interface version and capabilities (also --version, -V).

Options:
  --json      Write one JSON summary document to stdout and human logs to stderr.
  --no-start  Leave containers stopped during switch or back and list them under
              containers_need_recreating instead of starting them.

Exit codes:
  0  Done (or nothing to do).
  1  Refused before changing anything (preflight failed or invalid arguments).
  2  Host state was changed, but a step, network, or container failed to come back.
EOF
}

say() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err() { printf 'ERROR: %s\n' "$*" >&2; }

json_init() {
	JSON_DIR=$(mktemp -d /tmp/netavark-migrate.XXXXXX)
	JSON_STATE="$JSON_DIR/json"
	mkdir -p "$JSON_STATE"
	: > "$JSON_STATE/meta.kv"
	: > "$JSON_STATE/networks.tsv"
	: > "$JSON_STATE/kept_nv.txt"
	: > "$JSON_STATE/started.txt"
	: > "$JSON_STATE/recreate.txt"
	: > "$JSON_STATE/failed_ctrs.txt"
	: > "$JSON_STATE/blockers.txt"
	: > "$JSON_STATE/warnings.txt"
	: > "$JSON_STATE/errors.txt"

	json_set_meta version "$INTERFACE_VERSION"
	json_set_meta action "${ACTION:-check}"
	json_set_meta ok "false"
	json_set_meta exit_code "1"
	json_set_meta changed "false"
	json_set_meta no_start "$([ "$NO_START" -eq 1 ] && printf true || printf false)"
	json_set_meta pf_changed "false"
	json_set_meta pf_status "unchanged"
	json_set_meta pf_detail ""
	json_set_meta sysctl_changed "false"
	json_set_meta sysctl_status "unchanged"
	json_set_meta sysctl_detail ""
	json_set_meta loader_changed "false"
	json_set_meta loader_status "unchanged"
	json_set_meta loader_detail ""
	json_set_meta dns_changed "false"
	json_set_meta dns_status "unchanged"
	json_set_meta dns_port "53"
	json_set_meta dns_file ""
	json_set_meta backend_changed "false"
	json_set_meta backend_from "unknown"
	json_set_meta backend_to "unknown"
	json_set_meta backend_service ""
	json_refresh_backups
}

json_clean_str() {
	printf '%s' "$1" | tr '\t\r\n' '   '
}

json_set_meta() {
	[ -n "${JSON_STATE:-}" ] || return 0
	printf '%s\t%s\n' "$1" "$(json_clean_str "${2:-}")" >> "$JSON_STATE/meta.kv"
}

json_add_net() {
	[ -n "${JSON_STATE:-}" ] || return 0
	printf '%s\t%s\t%s\t%s\t%s\n' \
		"$(json_clean_str "${1:-}")" \
		"$(json_clean_str "${2:-}")" \
		"$(json_clean_str "${3:-}")" \
		"$(json_clean_str "${4:-}")" \
		"$(json_clean_str "${5:-}")" >> "$JSON_STATE/networks.tsv"
}

json_add_list() {
	[ -n "${JSON_STATE:-}" ] || return 0
	[ -n "${2:-}" ] || return 0
	printf '%s\n' "$(json_clean_str "$2")" >> "$JSON_STATE/$1.txt"
}

pf_backup_path() {
	if [ -f "$BEFORE_FJORD_PF" ]; then
		printf '%s' "$BEFORE_FJORD_PF"
	elif [ -f "$STATE_DIR/pf.conf.pre-netavark" ]; then
		printf '%s' "$STATE_DIR/pf.conf.pre-netavark"
	fi
}

json_refresh_backups() {
	[ -n "${JSON_STATE:-}" ] || return 0
	json_set_meta backup_state_dir "$([ -d "$STATE_DIR" ] && printf '%s' "$STATE_DIR" || printf '')"
	json_set_meta backup_pf_conf "$(pf_backup_path)"
	json_set_meta backup_cni_conflists "$([ -d "$STATE_DIR/cni-net.d" ] && printf '%s' "$STATE_DIR/cni-net.d" || printf '')"
	json_set_meta backup_before_netavark "$([ -d "$BEFORE_CNI_DIR" ] && printf '%s' "$BEFORE_CNI_DIR" || printf '')"
	json_set_meta backup_netavark_networks "$([ -d "$STATE_DIR/netavark-networks.bak" ] && printf '%s' "$STATE_DIR/netavark-networks.bak" || printf '')"
	json_set_meta backup_recreate_commands "$([ -f "$STATE_DIR/recreate-commands.sh" ] && printf '%s' "$STATE_DIR/recreate-commands.sh" || printf '')"
	_cc_bak=""
	if [ -d "$STATE_DIR/containers-conf.bak" ]; then
		_cc_bak="$STATE_DIR/containers-conf.bak"
	elif [ -d "$STATE_DIR/containers-conf-back.bak" ]; then
		_cc_bak="$STATE_DIR/containers-conf-back.bak"
	fi
	json_set_meta backup_containers_conf "$_cc_bak"
}

emit_json() {
	[ "$JSON_MODE" -eq 1 ] || return 0
	[ "$JSON_EMITTED" -eq 0 ] || return 0
	JSON_EMITTED=1
	json_refresh_backups
	run_lua emit_json "$JSON_STATE" >&3
}

finish_rc() {
	_frc="$1"
	if [ "$_frc" -eq 0 ]; then
		json_set_meta ok "true"
	else
		json_set_meta ok "false"
	fi
	json_set_meta exit_code "$_frc"
	emit_json
	exit "$_frc"
}

cleanup_on_exit() {
	_trc=$?
	if [ "${JSON_MODE:-0}" -eq 1 ] && [ "${JSON_EMITTED:-0}" -eq 0 ] && [ -n "${JSON_STATE:-}" ] && [ -d "$JSON_STATE" ]; then
		if [ "${HOST_MUTATED:-0}" -eq 1 ]; then
			_trc=2
		elif [ "$_trc" -eq 0 ]; then
			_trc=1
		fi
		json_set_meta ok "false"
		json_set_meta exit_code "$_trc"
		if [ ! -s "$JSON_STATE/blockers.txt" ] && [ ! -s "$JSON_STATE/errors.txt" ]; then
			if [ "${HOST_MUTATED:-0}" -eq 1 ]; then
				json_add_list errors "command aborted unexpectedly"
			else
				json_add_list blockers "command aborted before modifying the host"
			fi
		fi
		emit_json || true
		[ -n "${JSON_DIR:-}" ] && rm -rf "$JSON_DIR"
		exit "$_trc"
	fi
	[ -n "${JSON_DIR:-}" ] && rm -rf "$JSON_DIR"
}

record_blocker() {
	err "$1"
	json_add_list blockers "$1"
}

record_warn() {
	warn "$1"
	json_add_list warnings "$1"
}

record_error() {
	err "$1"
	json_add_list errors "$1"
}

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		record_blocker "must run as root"
		finish_rc 1
	fi
}

pman() {
	if [ -n "$PODMAN_CONF_OVERRIDE" ]; then
		CONTAINERS_CONF_OVERRIDE="$PODMAN_CONF_OVERRIDE" podman "$@"
	else
		podman "$@"
	fi
}

ctr_exists() {
	pman container exists "$1" >/dev/null 2>&1
}

ctr_running() {
	[ "$(pman inspect --format '{{.State.Running}}' "$1" 2>/dev/null || printf false)" = "true" ]
}

ctr_autoremove() {
	[ "$(pman inspect --format '{{.HostConfig.AutoRemove}}' "$1" 2>/dev/null || printf false)" = "true" ]
}

stop_running_ctrs() {
	_src_file="$1"
	_src_err="$2"
	_src_ctx="$3"
	[ -s "$_src_file" ] || return 0
	_src_list=$(tr '\n' ' ' < "$_src_file")
	say "  stopping running containers $_src_ctx: $_src_list"
	# shellcheck disable=SC2086
	if pman stop -i -t 10 $_src_list >/dev/null 2>"$_src_err"; then
		return 0
	fi
	_src_still=""
	_src_last_err=$(cat "$_src_err" 2>/dev/null || printf '')
	for _sc in $(cat "$_src_file"); do
		ctr_exists "$_sc" || continue
		ctr_running "$_sc" || continue
		if ! pman stop -i -t 10 "$_sc" >/dev/null 2>"$_src_err"; then
			if ctr_exists "$_sc" && ctr_running "$_sc"; then
				_src_still="${_src_still}${_src_still:+ }$_sc"
				_src_last_err=$(cat "$_src_err" 2>/dev/null || printf '')
			fi
		fi
	done
	if [ -n "$_src_still" ]; then
		_src_msg=$(printf '%s' "$_src_last_err" | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
		[ -n "$_src_msg" ] || _src_msg="podman stop failed"
		record_error "failed stopping running containers $_src_ctx ($_src_still): $_src_msg"
		FAILURES=$((FAILURES + 1))
		return 1
	fi
	return 0
}

wait_autoremove_ctrs() {
	_wac_file="$1"
	[ -s "$_wac_file" ] || return 0
	for _wc in $(cat "$_wac_file"); do
		_wi=0
		while [ "$_wi" -lt 30 ]; do
			if ! ctr_exists "$_wc" || ctr_running "$_wc"; then
				break
			fi
			sleep 0.1
			_wi=$((_wi + 1))
		done
	done
}

podman_version() {
	podman --version 2>/dev/null | awk '{print $3}'
}

podman_major() {
	_pv=$(podman_version)
	_pm=${_pv%%.*}
	case "$_pm" in
		''|*[!0-9]*) printf '0\n' ;;
		*) printf '%s\n' "$_pm" ;;
	esac
}

backend_of() {
	pman info --format '{{.Host.NetworkBackend}}' 2>/dev/null || printf 'unknown'
}

podman_service_socket() {
	if [ -n "$PODMAN_SOCK" ]; then
		printf '%s\n' "$PODMAN_SOCK"
		return
	fi
	_sock=$(sysrc -qn podman_service_api_socket 2>/dev/null || true)
	if [ -n "$_sock" ]; then
		printf '%s\n' "$_sock"
		return
	fi
	_rundir=$(sysrc -qn podman_service_api_rundir 2>/dev/null || true)
	[ -n "$_rundir" ] || _rundir="/var/run/podman"
	printf '%s/podman.sock\n' "$_rundir"
}

service_backend_of() {
	_sock=$(podman_service_socket)
	[ -S "$_sock" ] || return 0
	pman --url "unix://$_sock" info --format '{{.Host.NetworkBackend}}' 2>/dev/null || true
}

stale_backend_conf_files() {
	_target_be="$1"
	for _cf in "$CONTAINERS_CONF_DIR/containers.conf" "$CONTAINERS_CONF_DIR"/containers.conf.d/*.conf; do
		[ -f "$_cf" ] || continue
		[ "$_cf" = "$CONF_DROPIN" ] && continue
		if grep -Eq "^[[:space:]]*network_backend[[:space:]]*=[[:space:]]*\"${_target_be}\"" "$_cf"; then
			printf '%s\n' "$_cf"
		fi
	done
}

stale_cni_conf_files() {
	stale_backend_conf_files cni
}

has_csv_token() {
	case ",$1," in
		*,"$2",*) return 0 ;;
		*) return 1 ;;
	esac
}

nv_networks_csv() {
	[ -d "$NV_NET_DIR" ] || return 0
	for _jf in "$NV_NET_DIR"/*.json; do
		[ -f "$_jf" ] || continue
		_jn=${_jf##*/}
		printf '%s,' "${_jn%.json}"
	done
}

leftover_cni_ifaces() {
	{
		ifconfig -l 2>/dev/null | tr ' ' '\n' | grep '^cni-podman' || true
		ifconfig -g epair 2>/dev/null | grep -E '^(vnet|eth[0-9])' || true
	} | sed '/^$/d' | sort -u
}

host_ifaces_csv() {
	ifconfig -l 2>/dev/null | tr ' ' ','
}

vlanfilter_bridges_csv() {
	for _b in $(ifconfig -g bridge 2>/dev/null || true); do
		if ifconfig "$_b" 2>/dev/null | grep -q 'bridge flags=.*VLANFILTER'; then
			printf '%s,' "$_b"
		fi
	done
}

host_53_listener() {
	sockstat -46l 2>/dev/null | awk 'NR > 1 && ($6 == "*:53" || $6 == "0.0.0.0:53" || $6 == "[::]:53") && !seen[$2,$3]++ { printf "%s (pid %s) ", $2, $3 }'
}

free_dns_port() {
	_used=$(sockstat -46l 2>/dev/null | awk 'NR > 1 { print $6 }' || true)
	_p="$DEFAULT_DNS_BIND_PORT"
	_limit=$((DEFAULT_DNS_BIND_PORT + 50))
	while [ "$_p" -lt "$_limit" ]; do
		if ! printf '%s\n' "$_used" | grep -Eq ":${_p}$"; then
			printf '%s\n' "$_p"
			return 0
		fi
		_p=$((_p + 1))
	done
	printf '%s\n' "$DEFAULT_DNS_BIND_PORT"
}

pf_active_anchors_ok() {
	_nat=$(pfctl -s nat 2>/dev/null || true)
	_rules=$(pfctl -s rules 2>/dev/null || true)
	case "$_nat" in
		*'nat-anchor "netavark/*"'*) ;;
		*) return 1 ;;
	esac
	case "$_nat" in
		*'rdr-anchor "netavark/*"'*) ;;
		*) return 1 ;;
	esac
	if printf '%s\n' "$_rules" | grep -Eq '^[[:space:]]*anchor[[:space:]]+"netavark/\*"'; then
		return 0
	fi
	return 1
}

# Pure-Lua JSON parser/encoder + migration planners wrapped via flua.
run_lua() {
	"$FLUA_BIN" - "$@" <<'LUA'
local mode = arg[1]

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function sh_quote(s)
	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local array_mt = {}
local function make_array(t)
	return setmetatable(t or {}, array_mt)
end

local function json_escape_str(s)
	s = tostring(s)
	local out = { '"' }
	for i = 1, #s do
		local b = s:byte(i)
		if b == 34 then out[#out + 1] = '\\"'
		elseif b == 92 then out[#out + 1] = '\\\\'
		elseif b == 8 then out[#out + 1] = '\\b'
		elseif b == 12 then out[#out + 1] = '\\f'
		elseif b == 10 then out[#out + 1] = '\\n'
		elseif b == 13 then out[#out + 1] = '\\r'
		elseif b == 9 then out[#out + 1] = '\\t'
		elseif b < 32 then out[#out + 1] = string.format('\\u%04x', b)
		else out[#out + 1] = string.char(b)
		end
	end
	out[#out + 1] = '"'
	return table.concat(out)
end

local function json_encode(val, indent, order_hint)
	indent = indent or 0
	local tv = type(val)
	if val == nil then
		return "null"
	elseif tv == "boolean" then
		return val and "true" or "false"
	elseif tv == "number" then
		return tostring(val)
	elseif tv == "string" then
		return json_escape_str(val)
	elseif tv == "table" then
		local pad = string.rep("  ", indent)
		local ipad = string.rep("  ", indent + 1)
		if getmetatable(val) == array_mt then
			if #val == 0 then return "[]" end
			local items = {}
			for i = 1, #val do
				items[#items + 1] = ipad .. json_encode(val[i], indent + 1, order_hint)
			end
			return "[\n" .. table.concat(items, ",\n") .. "\n" .. pad .. "]"
		else
			local keys = {}
			local seen = {}
			local hints = val.__order or (order_hint and order_hint[val])
			if hints then
				for _, k in ipairs(hints) do
					if val[k] ~= nil then
						keys[#keys + 1] = k
						seen[k] = true
					end
				end
			end
			local extra = {}
			for k in pairs(val) do
				if k ~= "__order" and not seen[k] then
					extra[#extra + 1] = tostring(k)
				end
			end
			table.sort(extra)
			for _, k in ipairs(extra) do
				keys[#keys + 1] = k
			end
			if #keys == 0 then return "{}" end
			local parts = {}
			for _, k in ipairs(keys) do
				parts[#parts + 1] = ipad .. json_escape_str(k) .. ": " .. json_encode(val[k], indent + 1, order_hint)
			end
			return "{\n" .. table.concat(parts, ",\n") .. "\n" .. pad .. "}"
		end
	end
	return "null"
end

-- Minimal strict JSON parser for CNI conflists and podman inspect output.
local function json_decode(str)
	local pos = 1
	local len = #str

	local function skip_ws()
		while pos <= len do
			local b = str:byte(pos)
			if b == 32 or b == 9 or b == 10 or b == 13 then
				pos = pos + 1
			else
				break
			end
		end
	end

	local parse_val

	local function utf8_char(cp)
		if cp < 0x80 then
			return string.char(cp)
		elseif cp < 0x800 then
			return string.char(
				0xC0 + math.floor(cp / 64),
				0x80 + (cp % 64)
			)
		elseif cp < 0x10000 then
			return string.char(
				0xE0 + math.floor(cp / 4096),
				0x80 + (math.floor(cp / 64) % 64),
				0x80 + (cp % 64)
			)
		else
			return string.char(
				0xF0 + math.floor(cp / 262144),
				0x80 + (math.floor(cp / 4096) % 64),
				0x80 + (math.floor(cp / 64) % 64),
				0x80 + (cp % 64)
			)
		end
	end

	local escapes = {
		['"'] = '"', ['\\'] = '\\', ['/'] = '/',
		b = '\b', f = '\f', n = '\n', r = '\r', t = '\t'
	}

	local function parse_str()
		pos = pos + 1
		local out = {}
		while pos <= len do
			local ch = str:sub(pos, pos)
			if ch == '"' then
				pos = pos + 1
				return table.concat(out)
			elseif ch == '\\' then
				pos = pos + 1
				local esc = str:sub(pos, pos)
				if escapes[esc] then
					out[#out + 1] = escapes[esc]
					pos = pos + 1
				elseif esc == 'u' then
					local hex = str:sub(pos + 1, pos + 4)
					local cp = tonumber(hex, 16)
					if not cp then error("bad unicode escape at " .. pos) end
					pos = pos + 5
					if cp >= 0xD800 and cp <= 0xDBFF and str:sub(pos, pos + 1) == '\\u' then
						local hex2 = str:sub(pos + 2, pos + 5)
						local cp2 = tonumber(hex2, 16)
						if cp2 and cp2 >= 0xDC00 and cp2 <= 0xDFFF then
							cp = 0x10000 + (cp - 0xD800) * 1024 + (cp2 - 0xDC00)
							pos = pos + 6
						end
					end
					out[#out + 1] = utf8_char(cp)
				else
					error("bad escape at " .. pos)
				end
			else
				local nxt = str:find('["\\]', pos)
				if not nxt then
					error("unterminated string")
				end
				if nxt > pos then
					out[#out + 1] = str:sub(pos, nxt - 1)
					pos = nxt
				else
					out[#out + 1] = ch
					pos = pos + 1
				end
			end
		end
		error("unterminated string")
	end

	local function parse_num()
		local s = str:match("^-?%d+%.?%d*[eE]?[+-]?%d*", pos)
		if not s or s == "" then error("bad number at " .. pos) end
		pos = pos + #s
		return tonumber(s)
	end

	local function parse_arr()
		pos = pos + 1
		skip_ws()
		local arr = {}
		if str:sub(pos, pos) == ']' then
			pos = pos + 1
			return arr
		end
		while true do
			arr[#arr + 1] = parse_val()
			skip_ws()
			local ch = str:sub(pos, pos)
			if ch == ']' then
				pos = pos + 1
				return arr
			elseif ch == ',' then
				pos = pos + 1
			else
				error("expected ',' or ']' at " .. pos)
			end
		end
	end

	local function parse_obj()
		pos = pos + 1
		skip_ws()
		local obj = {}
		if str:sub(pos, pos) == '}' then
			pos = pos + 1
			return obj
		end
		while true do
			skip_ws()
			if str:sub(pos, pos) ~= '"' then error("expected string key at " .. pos) end
			local k = parse_str()
			skip_ws()
			if str:sub(pos, pos) ~= ':' then error("expected ':' at " .. pos) end
			pos = pos + 1
			obj[k] = parse_val()
			skip_ws()
			local ch = str:sub(pos, pos)
			if ch == '}' then
				pos = pos + 1
				return obj
			elseif ch == ',' then
				pos = pos + 1
			else
				error("expected ',' or '}' at " .. pos)
			end
		end
	end

	parse_val = function()
		skip_ws()
		local ch = str:sub(pos, pos)
		if ch == '"' then return parse_str()
		elseif ch == '{' then return parse_obj()
		elseif ch == '[' then return parse_arr()
		elseif ch == 't' and str:sub(pos, pos + 3) == 'true' then pos = pos + 4; return true
		elseif ch == 'f' and str:sub(pos, pos + 4) == 'false' then pos = pos + 5; return false
		elseif ch == 'n' and str:sub(pos, pos + 3) == 'null' then pos = pos + 4; return nil
		else return parse_num()
		end
	end

	local val = parse_val()
	skip_ws()
	return val
end

local function read_file(path)
	local f, e = io.open(path, "r")
	if not f then return nil, e end
	local s = f:read("*a")
	f:close()
	return s
end

local function append_ipam_flags(cmd, ipam)
	local has_v6 = false
	local ip_flags = {}
	local ranges = (ipam and ipam.ranges) or {}
	for _, grp in ipairs(ranges) do
		if type(grp) == "table" then
			for _, r in ipairs(grp) do
				if type(r) == "table" and r.subnet then
					local sub = tostring(r.subnet)
					if sub:find(":", 1, true) then has_v6 = true end
					ip_flags[#ip_flags + 1] = "--subnet"
					ip_flags[#ip_flags + 1] = sub
					if r.gateway and r.gateway ~= "" then
						ip_flags[#ip_flags + 1] = "--gateway"
						ip_flags[#ip_flags + 1] = tostring(r.gateway)
					end
					if r.rangeStart and r.rangeEnd and r.rangeStart ~= "" and r.rangeEnd ~= "" then
						ip_flags[#ip_flags + 1] = "--ip-range"
						ip_flags[#ip_flags + 1] = tostring(r.rangeStart) .. "-" .. tostring(r.rangeEnd)
					end
				end
			end
		end
	end
	if has_v6 then cmd[#cmd + 1] = "--ipv6" end
	for _, f in ipairs(ip_flags) do cmd[#cmd + 1] = f end
end

local function exec_conflists()
	local epair_nv = arg[2]
	local ifaces_csv = arg[3] or ""
	local vlan_csv = arg[4] or ""
	local nv_csv = arg[5] or ""
	local ifaces = {}
	for tok in ifaces_csv:gmatch("[^,]+") do
		ifaces[tok] = true
	end
	local vlan_ifaces = {}
	for tok in vlan_csv:gmatch("[^,]+") do
		vlan_ifaces[tok] = true
	end
	local nv_nets = {}
	for tok in nv_csv:gmatch("[^,]+") do
		nv_nets[tok] = true
	end
	local has_epair_nv = false
	local ef = io.open(epair_nv, "r")
	if ef then
		ef:close()
		has_epair_nv = (os.execute("test -x " .. sh_quote(epair_nv)) == true)
	end

	for i = 6, #arg do
		local path = arg[i]
		local text, rerr = read_file(path)
		if not text then
			local bmsg = "cannot read " .. path .. ": " .. tostring(rerr)
			print("BLOCKER\t" .. bmsg)
			print("NETPLAN\t" .. path .. "\tcni\t\tblocked\t" .. bmsg)
		else
			local ok, doc = pcall(json_decode, text)
			if not ok or type(doc) ~= "table" then
				local bmsg = "invalid JSON in " .. path .. ": " .. tostring(doc)
				print("BLOCKER\t" .. bmsg)
				print("NETPLAN\t" .. path .. "\tcni\t\tblocked\t" .. bmsg)
			else
				local name = doc.name
				local plugins = doc.plugins or { doc }
				local main = plugins[1]
				if not name or type(main) ~= "table" then
					local bmsg = path .. " missing name or plugins[1]"
					print("BLOCKER\t" .. bmsg)
					print("NETPLAN\t" .. tostring(name or path) .. "\tcni\t\tblocked\t" .. bmsg)
				else
					local ptype = tostring(main.type or "")
					print("CNINET\t" .. name)
					local has_dnsname = false
					for _, p in ipairs(plugins) do
						if type(p) == "table" and p.type == "dnsname" then
							has_dnsname = true
						end
					end

					if name ~= "podman" and nv_nets[name] then
						if ptype == "bridge" and main.bridge and tostring(main.bridge) ~= "" then
							print("CNIBRIDGE\t" .. tostring(main.bridge))
						end
						print("INFO\t" .. name .. " -> already exists in netavark; will archive CNI conflist")
						print("NETPLAN\t" .. name .. "\tcni-" .. ptype .. "\tnetavark\texists\t")
					elseif ptype == "bridge" then
						local br = tostring(main.bridge or "")
						if br ~= "" then
							print("CNIBRIDGE\t" .. br)
						end
						local ipam = main.ipam or {}
						local ranges = ipam.ranges or {}
						local is_default = (name == "podman")
						if is_default then
							local sub = (ranges[1] and ranges[1][1] and ranges[1][1].subnet) or ""
							if sub == "10.88.0.0/16" or sub == "" then
								print("INFO\t" .. name .. " -> built-in netavark default network (podman, 10.88.0.0/16)")
								print("NETPLAN\t" .. name .. "\tcni-bridge\tpodman\tbuiltin\t")
							else
								local bmsg = name .. " uses custom default subnet " .. sub .. "; rename before migrating"
								print("BLOCKER\t" .. bmsg)
								print("NETPLAN\t" .. name .. "\tcni-bridge\tbridge\tblocked\t" .. bmsg)
							end
						elseif ipam.type ~= "host-local" and ipam.type ~= nil then
							local bmsg = name .. " (bridge) uses unsupported IPAM driver '" .. tostring(ipam.type) .. "'"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\tcni-bridge\tbridge\tblocked\t" .. bmsg)
						else
							local cmd = { "podman", "network", "create" }
							if not has_dnsname then
								cmd[#cmd + 1] = "--disable-dns"
							end
							if main.isGateway == false and main.ipMasq == false then
								cmd[#cmd + 1] = "--internal"
							end
							if main.mtu then
								cmd[#cmd + 1] = "-o"
								cmd[#cmd + 1] = "mtu=" .. tostring(main.mtu)
							end
							append_ipam_flags(cmd, ipam)
							cmd[#cmd + 1] = name
							local q = {}
							for _, tok in ipairs(cmd) do q[#q + 1] = sh_quote(tok) end
							local cmd_str = table.concat(q, " ")
							local plain_str = table.concat(cmd, " ")
							print("CREATE\t" .. name .. "\tbridge" .. "\t" .. cmd_str)
							print("INFO\t" .. name .. " (CNI bridge -> netavark bridge): " .. plain_str)
							print("NETPLAN\t" .. name .. "\tcni-bridge\tbridge\twould_create\t")
						end
					elseif ptype == "epair" then
						local master = tostring(main.master or main.bridge or "")
						local ipam = main.ipam or {}
						local itype = tostring(ipam.type or "host-local")
						local has_vlan = (main.vlan ~= nil and tostring(main.vlan) ~= "")
							or (main.taggedVlans ~= nil and tostring(main.taggedVlans) ~= "")
						local cni_from = (itype == "dhcp" and "cni-epair-dhcp") or (has_vlan and "cni-epair-vlan") or "cni-epair"
						local nv_to = (itype == "dhcp" and "epair-dhcp") or (has_vlan and "epair-vlan") or "epair-unmanaged"
						if master == "" then
							local bmsg = name .. " (epair) has no master bridge configured"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						elseif not ifaces[master] then
							local bmsg = name .. " (epair) host bridge '" .. master .. "' does not exist"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						elseif has_vlan and type(main.taggedVlans) == "table" then
							local bmsg = name .. " (epair VLAN) taggedVlans must be a string such as \"3,4\", not an array"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						elseif (itype == "dhcp" or (itype == "host-local" and has_vlan)) and not has_epair_nv then
							local bmsg = name .. " (epair " .. itype .. ") requires " .. epair_nv .. " (cni-epair with netavark mode)"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						elseif has_vlan and not vlan_ifaces[master] then
							local bmsg = name .. " (epair VLAN) host bridge '" .. master .. "' does not have vlanfilter enabled; run: ifconfig " .. master .. " vlanfilter"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						elseif itype == "dhcp" then
							local cmd = {
								"podman", "network", "create", "--disable-dns",
								"-d", "epair", "--ipam-driver", "none",
								"--interface-name", master
							}
							if main.mtu then
								cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "mtu=" .. tostring(main.mtu)
							end
							if main.vlan then
								cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "vlan=" .. tostring(main.vlan)
							end
							if main.taggedVlans then
								cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "taggedVlans=" .. tostring(main.taggedVlans)
							end
							cmd[#cmd + 1] = name
							local q = {}
							for _, tok in ipairs(cmd) do q[#q + 1] = sh_quote(tok) end
							print("CREATE\t" .. name .. "\tepair-dhcp\t" .. table.concat(q, " "))
							print("INFO\t" .. name .. " (CNI epair DHCP -> netavark epair plugin): " .. table.concat(cmd, " "))
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\tepair-dhcp\twould_create\t")
						elseif itype == "host-local" then
							if has_vlan then
								local cmd = {
									"podman", "network", "create", "--disable-dns",
									"-d", "epair", "--interface-name", master
								}
								if main.mtu then
									cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "mtu=" .. tostring(main.mtu)
								end
								if main.vlan then
									cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "vlan=" .. tostring(main.vlan)
								end
								if main.taggedVlans then
									cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "taggedVlans=" .. tostring(main.taggedVlans)
								end
								append_ipam_flags(cmd, ipam)
								cmd[#cmd + 1] = name
								local q = {}
								for _, tok in ipairs(cmd) do q[#q + 1] = sh_quote(tok) end
								print("CREATE\t" .. name .. "\tepair-vlan\t" .. table.concat(q, " "))
								print("INFO\t" .. name .. " (CNI epair host-local VLAN -> netavark epair plugin on " .. master .. "): " .. table.concat(cmd, " "))
								print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\tepair-vlan\twould_create\t")
							else
								local cmd = {
									"podman", "network", "create", "--disable-dns",
									"-d", "bridge", "-o", "mode=unmanaged",
									"--interface-name", master
								}
								if main.mtu then
									cmd[#cmd + 1] = "-o"; cmd[#cmd + 1] = "mtu=" .. tostring(main.mtu)
								end
								append_ipam_flags(cmd, ipam)
								cmd[#cmd + 1] = name
								local q = {}
								for _, tok in ipairs(cmd) do q[#q + 1] = sh_quote(tok) end
								print("CREATE\t" .. name .. "\tepair-unmanaged\t" .. table.concat(q, " "))
								print("INFO\t" .. name .. " (CNI epair host-local -> unmanaged bridge on " .. master .. "): " .. table.concat(cmd, " "))
								print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\tepair-unmanaged\twould_create\t")
							end
						else
							local bmsg = name .. " (epair) uses unsupported IPAM driver '" .. itype .. "'"
							print("BLOCKER\t" .. bmsg)
							print("NETPLAN\t" .. name .. "\t" .. cni_from .. "\t" .. nv_to .. "\tblocked\t" .. bmsg)
						end
					else
						local bmsg = name .. " uses unsupported CNI plugin '" .. ptype .. "'"
						print("BLOCKER\t" .. bmsg)
						print("NETPLAN\t" .. name .. "\tcni-" .. ptype .. "\t\tblocked\t" .. bmsg)
					end
				end
			end
		end
	end
end

local function extract_pins(create_cmd)
	local pins = {}
	if type(create_cmd) ~= "table" then return pins end
	local i = 1
	while i <= #create_cmd do
		local a = tostring(create_cmd[i])
		if a == "--ip" and create_cmd[i + 1] then
			pins[#pins + 1] = "ip=" .. tostring(create_cmd[i + 1])
			i = i + 2
		elseif a:match("^%-%-ip=") then
			pins[#pins + 1] = "ip=" .. a:sub(6)
			i = i + 1
		elseif a == "--ip6" and create_cmd[i + 1] then
			pins[#pins + 1] = "ip6=" .. tostring(create_cmd[i + 1])
			i = i + 2
		elseif a:match("^%-%-ip6=") then
			pins[#pins + 1] = "ip6=" .. a:sub(7)
			i = i + 1
		elseif a == "--mac-address" and create_cmd[i + 1] then
			pins[#pins + 1] = "mac=" .. tostring(create_cmd[i + 1])
			i = i + 2
		elseif a:match("^%-%-mac%-address=") then
			pins[#pins + 1] = "mac=" .. a:sub(15)
			i = i + 1
		else
			i = i + 1
		end
	end
	return pins
end

local function csv_set(csv)
	local s = {}
	for tok in (csv or ""):gmatch("[^,]+") do
		s[tok] = true
	end
	return s
end

local function read_ps_nets(ps_nets_path)
	local ps_nets_by_name = {}
	if ps_nets_path ~= "" then
		local pt = read_file(ps_nets_path)
		if pt then
			for pline in pt:gmatch("[^\r\n]+") do
				local pname, pnets = pline:match("^([^\t]+)\t(.*)$")
				if pname and pnets and trim(pnets) ~= "" then
					ps_nets_by_name[pname] = pnets
				end
			end
		end
	end
	return ps_nets_by_name
end

local function extract_ctr_nets(c, ps_nets_by_name)
	local name = tostring(c.Name or "")
	local net_map = (c.NetworkSettings and c.NetworkSettings.Networks) or {}
	local nets = {}
	local live = {}
	for k, v in pairs(net_map) do
		nets[#nets + 1] = k
		if type(v) == "table" then
			local parts = {}
			if v.IPAddress and v.IPAddress ~= "" then parts[#parts + 1] = v.IPAddress end
			if v.MacAddress and v.MacAddress ~= "" then parts[#parts + 1] = v.MacAddress end
			if #parts > 0 then
				live[#live + 1] = k .. ":" .. table.concat(parts, "/")
			end
		end
	end
	if #nets == 0 and ps_nets_by_name[name] then
		for tok in ps_nets_by_name[name]:gmatch("[^,]+") do
			tok = trim(tok)
			if tok ~= "" then
				nets[#nets + 1] = tok
			end
		end
	end
	return nets, live
end

local function exec_containers()
	local inspect_path = arg[2]
	local running_path = arg[3] or ""
	local recreate_path = arg[4] or ""
	local pmajor = tonumber(arg[5]) or 0
	local cni_nets = csv_set(arg[6])
	local nv_nets = csv_set(arg[7])
	local stop_now_path = arg[8] or ""
	local ps_nets_path = arg[9] or ""
	local host_net_work = (tonumber(arg[10]) or 1) ~= 0
	local autorm_path = arg[11] or ""
	local ps_nets_by_name = read_ps_nets(ps_nets_path)
	local text, rerr = read_file(inspect_path)
	if not text or trim(text) == "" then
		return
	end
	local arr = json_decode(text)
	if type(arr) ~= "table" then error("inspect output is not an array") end

	local stop_now_lines = {}
	local autorm_lines = {}
	local run_lines = {}
	local rec_lines = { "#!/bin/sh", "# Captured pre-migration container run commands (fallback only)" }
	local p6_work = 0

	for _, c in ipairs(arr) do
		local name = tostring(c.Name or "")
		local is_running = (c.State and c.State.Running == true)
		local auto_remove = (c.HostConfig and c.HostConfig.AutoRemove == true)
		local err_str = tostring((c.State and c.State.Error) or "")
		local stopped_by_user = (c.State and c.State.StoppedByUser == true)
		local rp = tostring((c.HostConfig and c.HostConfig.RestartPolicy and c.HostConfig.RestartPolicy.Name) or "")
		local nets, live = extract_ctr_nets(c, ps_nets_by_name)
		local uses_custom_cni = false
		local missing_net = nil
		for _, k in ipairs(nets) do
			if k ~= "podman" and k ~= "bridge" and k ~= "default" then
				if cni_nets[k] and not nv_nets[k] then
					uses_custom_cni = true
				elseif not nv_nets[k] and not cni_nets[k] then
					missing_net = k
				end
			end
		end
		table.sort(nets)
		table.sort(live)

		local pins = extract_pins(c.Config and c.Config.CreateCommand)
		local note_parts = {}
		if #pins > 0 then note_parts[#note_parts + 1] = "pinned(" .. table.concat(pins, ",") .. ")" end
		if #live > 0 then note_parts[#note_parts + 1] = "live(" .. table.concat(live, ";") .. ")" end
		local note = #note_parts > 0 and table.concat(note_parts, " ") or "pool"

		local state_label = is_running and "running" or "stopped"
		local action = "keep stopped in place"
		if auto_remove then
			if is_running then
				action = "stop ephemeral (--rm) container"
				stop_now_lines[#stop_now_lines + 1] = name
				autorm_lines[#autorm_lines + 1] = name
			else
				action = "ignore stopped ephemeral (--rm) container"
			end
		elseif pmajor < 6 then
			if is_running then
				action = "stop on CNI -> carry over in place -> start on netavark"
				stop_now_lines[#stop_now_lines + 1] = name
				run_lines[#run_lines + 1] = name
			end
		else
			if is_running then
				stop_now_lines[#stop_now_lines + 1] = name
				run_lines[#run_lines + 1] = name
				if uses_custom_cni or cni_nets["podman"] then
					action = "stop pre-upgrade CNI jail -> remake network -> start on netavark"
					p6_work = p6_work + 1
				elseif host_net_work then
					action = "restart on netavark after host/pf setup"
				else
					action = "keep running (already on netavark)"
				end
			elseif err_str:find("network not found", 1, true) ~= nil then
				state_label = "stopped (error: network not found)"
				if missing_net == nil then
					action = "remake network -> start on netavark"
					run_lines[#run_lines + 1] = name
					p6_work = p6_work + 1
				else
					action = "keep stopped (missing CNI conflist for '" .. missing_net .. "')"
					print("WARN\tcontainer " .. name .. " failed with 'network not found' for '" .. missing_net .. "', which has no CNI conflist")
					print("NEED_RECREATE\t" .. name)
				end
			elseif (not stopped_by_user) and (rp == "always" or rp == "unless-stopped") and uses_custom_cni then
				state_label = "stopped (restart=" .. rp .. ")"
				action = "remake network -> start on netavark"
				run_lines[#run_lines + 1] = name
				p6_work = p6_work + 1
			end
		end

		print(string.format("CTR\t%s\t%s\t%s\t%s\t%s",
			name, state_label, #nets > 0 and table.concat(nets, ",") or "none", note, action))

		if not auto_remove then
			local cc = c.Config and c.Config.CreateCommand
			if type(cc) == "table" and #cc > 0 then
				local q = {}
				for _, tok in ipairs(cc) do q[#q + 1] = sh_quote(tok) end
				rec_lines[#rec_lines + 1] = "# " .. name
				rec_lines[#rec_lines + 1] = table.concat(q, " ")
			end
		end
	end

	print("P6_WORK\t" .. tostring(p6_work))

	if stop_now_path ~= "" then
		local sf = assert(io.open(stop_now_path, "w"))
		if #stop_now_lines > 0 then sf:write(table.concat(stop_now_lines, "\n") .. "\n") end
		sf:close()
	end
	if autorm_path ~= "" then
		local af = assert(io.open(autorm_path, "w"))
		if #autorm_lines > 0 then af:write(table.concat(autorm_lines, "\n") .. "\n") end
		af:close()
	end
	if running_path ~= "" then
		local rf = assert(io.open(running_path, "w"))
		if #run_lines > 0 then rf:write(table.concat(run_lines, "\n") .. "\n") end
		rf:close()
	end
	if recreate_path ~= "" then
		local cf = assert(io.open(recreate_path, "w"))
		cf:write(table.concat(rec_lines, "\n") .. "\n")
		cf:close()
	end
end

local function first_kw(line)
	if line:match("^%s*$") or line:match("^%s*#") then return nil end
	return line:match("^%s*([%a%-]+)")
end

local function exec_pf()
	local pf_action = arg[2]
	local pf_path = arg[3]
	local out_path = arg[4] or ""
	local create_missing = (arg[5] == "1")
	local text, rerr = read_file(pf_path)
	if not text then
		if pf_action == "update" and create_missing then
			text = ""
		else
			print("MISSING\t" .. tostring(rerr))
			return
		end
	end

	local lines = {}
	for line in (text .. "\n"):gmatch("([^\r\n]*)\r?\n") do
		lines[#lines + 1] = line
	end
	if #lines > 0 and lines[#lines] == "" then
		table.remove(lines)
	end

	local has_nat, has_rdr, has_flt = false, false, false
	for _, line in ipairs(lines) do
		if not line:match("^%s*#") then
			if line:match('^%s*nat%-anchor%s+"netavark/%*"') then has_nat = true end
			if line:match('^%s*rdr%-anchor%s+"netavark/%*"') then has_rdr = true end
			if line:match('^%s*anchor%s+"netavark/%*"') then has_flt = true end
		end
	end

	local missing = {}
	if not has_nat then missing[#missing + 1] = 'nat-anchor "netavark/*"' end
	if not has_rdr then missing[#missing + 1] = 'rdr-anchor "netavark/*"' end
	if not has_flt then missing[#missing + 1] = 'anchor "netavark/*"' end

	if pf_action == "check" then
		if #missing == 0 then
			print("OK\tall netavark anchors present in " .. pf_path)
		else
			print("MISSING\t" .. table.concat(missing, "; "))
		end
		return
	end

	if #missing == 0 then
		print("UNCHANGED")
		return
	end

	local flt_kws = {
		antispoof = true, anchor = true, block = true, match = true, pass = true
	}

	local to_xlate = {}
	if not has_nat then to_xlate[#to_xlate + 1] = 'nat-anchor "netavark/*"' end
	if not has_rdr then to_xlate[#to_xlate + 1] = 'rdr-anchor "netavark/*"' end

	if #to_xlate > 0 then
		local idx = #lines + 1
		for i, line in ipairs(lines) do
			local kw = first_kw(line)
			if kw and flt_kws[kw] then
				idx = i
				break
			end
		end
		for j = #to_xlate, 1, -1 do
			table.insert(lines, idx, to_xlate[j])
		end
	end

	if not has_flt then
		lines[#lines + 1] = 'anchor "netavark/*"'
	end

	local of = assert(io.open(out_path, "w"))
	of:write(table.concat(lines, "\n") .. "\n")
	of:close()
	print("UPDATED\t" .. table.concat(missing, "; "))
end

local function exec_dnsport()
	local port = 0
	local file = ""
	for i = 2, #arg do
		local path = arg[i]
		local text = read_file(path)
		if text then
			local section = ""
			for raw in (text .. "\n"):gmatch("([^\r\n]*)\r?\n") do
				local l = trim(raw:gsub("#.*$", ""))
				if l:match("^%[.*%]$") then
					section = trim(l:sub(2, -2))
				elseif section == "network" then
					local k, v = l:match("^([%w_]+)%s*=%s*(.+)$")
					if k == "dns_bind_port" then
						local n = tonumber(trim(v))
						if n and n > 0 and n < 65536 then
							port = math.floor(n)
							file = path
						end
					end
				end
			end
		end
	end
	print(string.format("%d\t%s", port, file))
end

local function read_lines_unique(path)
	local out = make_array({})
	local seen = {}
	local text = read_file(path)
	if not text then return out end
	for line in text:gmatch("[^\r\n]+") do
		line = trim(line)
		if line ~= "" and not seen[line] then
			seen[line] = true
			out[#out + 1] = line
		end
	end
	return out
end

local function read_lines_all(path)
	local out = make_array({})
	local text = read_file(path)
	if not text then return out end
	for line in text:gmatch("[^\r\n]+") do
		line = trim(line)
		if line ~= "" then
			out[#out + 1] = line
		end
	end
	return out
end

local function exec_emit_json()
	local state_dir = arg[2]
	local meta = {}
	local mtext = read_file(state_dir .. "/meta.kv")
	if mtext then
		for line in mtext:gmatch("[^\r\n]+") do
			local k, v = line:match("^([^\t]+)\t(.*)$")
			if k then
				meta[k] = v
			end
		end
	end

	local function mbool(k) return meta[k] == "true" end
	local function mstr(k, d) return meta[k] or (d or "") end
	local function mnum(k, d) return tonumber(meta[k]) or (d or 0) end

	local nets = make_array({})
	local nets_by_name = {}
	local ntext = read_file(state_dir .. "/networks.tsv")
	if ntext then
		for line in ntext:gmatch("[^\r\n]+") do
			local f1, f2, f3, f4, f5 = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
			if f1 and f1 ~= "" then
				local entry = nets_by_name[f1]
				if not entry then
					entry = {
						__order = { "name", "from", "to", "result", "error" },
						name = f1,
						from = f2,
						to = f3,
						result = f4,
					}
					if f5 ~= "" then entry.error = f5 end
					nets[#nets + 1] = entry
					nets_by_name[f1] = entry
				else
					if f2 ~= "" then entry.from = f2 end
					if f3 ~= "" then entry.to = f3 end
					if f4 ~= "" then entry.result = f4 end
					if f5 ~= "" then
						entry.error = f5
					else
						entry.error = nil
					end
				end
			end
		end
	end

	local doc = {
		__order = {
			"version", "action", "ok", "exit_code", "changed", "no_start",
			"pf", "sysctl", "loader", "dns_bind_port", "backend", "networks",
			"kept_netavark_networks", "containers_started",
			"containers_need_recreating", "containers_failed",
			"blockers", "warnings", "errors", "backups"
		},
		version = mnum("version", 2),
		action = mstr("action", "check"),
		ok = mbool("ok"),
		exit_code = mnum("exit_code", 1),
		changed = mbool("changed"),
		no_start = mbool("no_start"),
		pf = {
			__order = { "changed", "status", "detail" },
			changed = mbool("pf_changed"),
			status = mstr("pf_status", "unchanged"),
			detail = mstr("pf_detail", ""),
		},
		sysctl = {
			__order = { "changed", "status", "detail" },
			changed = mbool("sysctl_changed"),
			status = mstr("sysctl_status", "unchanged"),
			detail = mstr("sysctl_detail", ""),
		},
		loader = {
			__order = { "changed", "status", "detail" },
			changed = mbool("loader_changed"),
			status = mstr("loader_status", "unchanged"),
			detail = mstr("loader_detail", ""),
		},
		dns_bind_port = {
			__order = { "changed", "status", "port", "file" },
			changed = mbool("dns_changed"),
			status = mstr("dns_status", "unchanged"),
			port = mnum("dns_port", 53),
			file = mstr("dns_file", ""),
		},
		backend = {
			__order = { "changed", "from", "to", "service" },
			changed = mbool("backend_changed"),
			from = mstr("backend_from", "unknown"),
			to = mstr("backend_to", "unknown"),
			service = mstr("backend_service", ""),
		},
		networks = nets,
		kept_netavark_networks = read_lines_unique(state_dir .. "/kept_nv.txt"),
		containers_started = read_lines_unique(state_dir .. "/started.txt"),
		containers_need_recreating = read_lines_unique(state_dir .. "/recreate.txt"),
		containers_failed = read_lines_unique(state_dir .. "/failed_ctrs.txt"),
		blockers = read_lines_all(state_dir .. "/blockers.txt"),
		warnings = read_lines_all(state_dir .. "/warnings.txt"),
		errors = read_lines_all(state_dir .. "/errors.txt"),
		backups = {
			__order = {
				"state_dir", "pf_conf", "cni_conflists",
				"before_netavark_conflists", "netavark_networks",
				"recreate_commands", "containers_conf"
			},
			state_dir = mstr("backup_state_dir", ""),
			pf_conf = mstr("backup_pf_conf", ""),
			cni_conflists = mstr("backup_cni_conflists", ""),
			before_netavark_conflists = mstr("backup_before_netavark", ""),
			netavark_networks = mstr("backup_netavark_networks", ""),
			recreate_commands = mstr("backup_recreate_commands", ""),
			containers_conf = mstr("backup_containers_conf", ""),
		},
	}
	print(json_encode(doc, 0))
end

local function exec_jsonname()
	local path = arg[2]
	local text = read_file(path)
	if text then
		local ok, doc = pcall(json_decode, text)
		if ok and type(doc) == "table" and doc.name and tostring(doc.name) ~= "" then
			print(tostring(doc.name))
			return
		end
	end
	local base = path:match("([^/]+)$") or path
	base = base:gsub("%.conflist$", ""):gsub("%.conf$", ""):gsub("%.json$", "")
	print(base)
end

local function exec_ctrnets()
	local inspect_path = arg[2]
	local ps_nets_by_name = read_ps_nets(arg[3] or "")
	local text = read_file(inspect_path)
	if not text or trim(text) == "" then return end
	local arr = json_decode(text)
	if type(arr) ~= "table" then error("inspect output is not an array") end
	for _, c in ipairs(arr) do
		local name = tostring(c.Name or "")
		local is_running = (c.State and c.State.Running == true) and "true" or "false"
		local auto_rm = (c.HostConfig and c.HostConfig.AutoRemove == true) and "true" or "false"
		local nets = extract_ctr_nets(c, ps_nets_by_name)
		table.sort(nets)
		print(string.format("%s\t%s\t%s\t%s", name, is_running, table.concat(nets, ","), auto_rm))
	end
end

if mode == "conflists" then
	exec_conflists()
elseif mode == "containers" then
	exec_containers()
elseif mode == "pf" then
	exec_pf()
elseif mode == "jsonname" then
	exec_jsonname()
elseif mode == "ctrnets" then
	exec_ctrnets()
elseif mode == "dnsport" then
	exec_dnsport()
elseif mode == "emit_json" then
	exec_emit_json()
else
	error("unknown lua mode: " .. tostring(mode))
end
LUA
}

collect_conflist_files() {
	CONFLIST_ARGS=""
	if [ -d "$CNI_DIR" ]; then
		for f in "$CNI_DIR"/*.conflist "$CNI_DIR"/*.conf; do
			[ -f "$f" ] || continue
			CONFLIST_ARGS="${CONFLIST_ARGS} $f"
		done
	fi
}

detect_dns_bind_port() {
	run_lua dnsport "$CONTAINERS_CONF_DIR/containers.conf" "$CONTAINERS_CONF_DIR"/containers.conf.d/*.conf
}

append_sysctl_filter_local() {
	mkdir -p "$(dirname "$SYSCTL_CONF")"
	if [ -f "$SYSCTL_CONF" ] && grep -Eq '^[[:space:]]*net\.pf\.filter_local[[:space:]]*=' "$SYSCTL_CONF"; then
		sed -i '' -E 's/^[[:space:]]*net\.pf\.filter_local[[:space:]]*=.*/net.pf.filter_local=1/' "$SYSCTL_CONF"
	elif [ -s "$SYSCTL_CONF" ] && [ -n "$(tail -c 1 "$SYSCTL_CONF")" ]; then
		printf '\nnet.pf.filter_local=1\n' >> "$SYSCTL_CONF"
	else
		printf 'net.pf.filter_local=1\n' >> "$SYSCTL_CONF"
	fi
}

probe_host_json_state() {
	_ph_be="$1"
	_ph_svc="$2"

	if [ -f "$SYSCTL_CONF" ] && grep -Eq '^[[:space:]]*net\.pf\.filter_local[[:space:]]*=[[:space:]]*1([[:space:]]*(#.*)?)?$' "$SYSCTL_CONF"; then
		SYSCTL_CONF_OK=1
	else
		SYSCTL_CONF_OK=0
	fi
	FILTER_LOCAL=$(sysctl -n net.pf.filter_local 2>/dev/null || printf '0')
	if [ "$FILTER_LOCAL" = "1" ] && [ "$SYSCTL_CONF_OK" -eq 1 ]; then
		json_set_meta sysctl_changed false
		json_set_meta sysctl_status ok
		json_set_meta sysctl_detail "net.pf.filter_local=1"
	else
		json_set_meta sysctl_changed false
		json_set_meta sysctl_status would_update
		json_set_meta sysctl_detail "net.pf.filter_local=$FILTER_LOCAL (conf=$SYSCTL_CONF_OK)"
	fi

	_cur_pfload=$(sysrc -f "$LOADER_CONF" -qn pf_load 2>/dev/null || true)
	if [ "$_cur_pfload" = "YES" ] || [ "$_cur_pfload" = "yes" ]; then
		LOADER_CONF_OK=1
		json_set_meta loader_changed false
		json_set_meta loader_status ok
		json_set_meta loader_detail "pf_load=YES in $LOADER_CONF"
	else
		LOADER_CONF_OK=0
		json_set_meta loader_changed false
		json_set_meta loader_status would_update
		json_set_meta loader_detail "pf_load=${_cur_pfload:-unset} in $LOADER_CONF"
	fi

	DNS_CUR=$(detect_dns_bind_port)
	CUR_DNS_PORT=${DNS_CUR%%	*}
	CUR_DNS_FILE=${DNS_CUR#*	}
	[ "$CUR_DNS_PORT" != "$DNS_CUR" ] || CUR_DNS_FILE=""
	DNS53=$(host_53_listener)
	DNS_NEEDS_CFG=0
	if [ "$CUR_DNS_PORT" -gt 0 ]; then
		json_set_meta dns_changed false
		json_set_meta dns_status already_set
		json_set_meta dns_port "$CUR_DNS_PORT"
		json_set_meta dns_file "$CUR_DNS_FILE"
	elif [ -n "$DNS53" ]; then
		DNS_NEEDS_CFG=1
		PICK_DNS_PORT=$(free_dns_port)
		json_set_meta dns_changed false
		json_set_meta dns_status would_update
		json_set_meta dns_port "$PICK_DNS_PORT"
		json_set_meta dns_file "$DNS_CONF_DROPIN"
	else
		json_set_meta dns_changed false
		json_set_meta dns_status ok
		json_set_meta dns_port "53"
		json_set_meta dns_file ""
	fi

	PF_STATUS=""
	if [ ! -f "$PF_CONF" ]; then
		json_set_meta pf_changed false
		json_set_meta pf_status blocked
		json_set_meta pf_detail "$PF_CONF not found"
	elif ! pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
		json_set_meta pf_changed false
		json_set_meta pf_status blocked
		json_set_meta pf_detail "pf is not enabled"
	else
		PF_STATUS=$(run_lua pf check "$PF_CONF")
		case "$PF_STATUS" in
			OK*)
				if pf_active_anchors_ok; then
					json_set_meta pf_changed false
					json_set_meta pf_status ok
					json_set_meta pf_detail "${PF_STATUS#OK	}"
				else
					json_set_meta pf_changed false
					json_set_meta pf_status would_update
					json_set_meta pf_detail "netavark anchors in $PF_CONF are not loaded in active ruleset"
				fi
				;;
			MISSING*)
				json_set_meta pf_changed false
				json_set_meta pf_status would_update
				json_set_meta pf_detail "${PF_STATUS#MISSING	}"
				;;
		esac
	fi

	json_set_meta backend_changed false
	json_set_meta backend_from "$_ph_be"
	json_set_meta backend_to "netavark"
	json_set_meta backend_service "$_ph_svc"
}

run_preflight() {
	BLOCKERS=0
	WARNINGS=0
	PLAN_CREATE_FILE="$1"
	PLAN_BRIDGES_FILE="$2"
	PLAN_RUN_FILE="$3"
	PLAN_RECREATE_FILE="$4"
	PLAN_INSPECT_FILE="$5"
	PLAN_STOP_NOW_FILE="$6"
	WORK_DIR=$(dirname "$PLAN_CREATE_FILE")

	: > "$PLAN_CREATE_FILE"
	: > "$PLAN_BRIDGES_FILE"
	: > "$PLAN_RUN_FILE"
	: > "$PLAN_RECREATE_FILE"
	: > "$PLAN_STOP_NOW_FILE"
	: > "$WORK_DIR/autorm"
	PODMAN_CONF_OVERRIDE=""

	say "== Host checks =="
	PVER=$(podman_version)
	PMAJOR=$(podman_major)
	say "  podman: ${PVER:-unknown}"
	STALE_CNI_CONFS=$(stale_cni_conf_files)
	BACKEND=$(backend_of)
	if [ "$PMAJOR" -ge 6 ] && { [ -n "$STALE_CNI_CONFS" ] || [ "$BACKEND" = "unknown" ]; }; then
		OVERRIDE_CONF="$WORK_DIR/override-netavark.conf"
		cat > "$OVERRIDE_CONF" <<'EOF'
[network]
network_backend = "netavark"
EOF
		PODMAN_CONF_OVERRIDE="$OVERRIDE_CONF"
		BACKEND=$(backend_of)
	fi
	say "  backend: $BACKEND"
	SVC_MISMATCH=0
	SVC_SOCK=$(podman_service_socket)
	SVC_BACKEND=$(service_backend_of)
	if [ -n "$SVC_BACKEND" ]; then
		if [ "$SVC_BACKEND" = "$BACKEND" ]; then
			say "  podman_service: $SVC_BACKEND ($SVC_SOCK, matches config)"
		else
			say "  podman_service: $SVC_BACKEND ($SVC_SOCK) != configured '$BACKEND'"
			record_warn "running podman_service uses '$SVC_BACKEND' while configuration selects '$BACKEND'; fix: service podman_service restart"
			WARNINGS=$((WARNINGS + 1))
			SVC_MISMATCH=1
		fi
	fi

	probe_host_json_state "$BACKEND" "$SVC_BACKEND"

	if [ "$PMAJOR" -lt 6 ]; then
		if [ "$BACKEND" = "netavark" ] && [ "$SVC_MISMATCH" -eq 0 ]; then
			say "  already running on netavark"
			if [ -d "$STATE_DIR" ]; then
				say "  rollback state present in $STATE_DIR (run 'netavark-migrate back' to return to CNI)"
			fi
			json_set_meta backend_to "netavark"
			return 2
		fi
		if [ "$BACKEND" != "cni" ] && [ "$BACKEND" != "netavark" ]; then
			record_blocker "unexpected Podman network backend '$BACKEND'"
			BLOCKERS=$((BLOCKERS + 1))
		fi
	else
		say "  mode: Podman 6 post-upgrade recovery (CNI backend removed in Podman 6)"
		if [ "$BACKEND" != "netavark" ]; then
			record_blocker "unexpected Podman network backend '$BACKEND'"
			BLOCKERS=$((BLOCKERS + 1))
		fi
		if [ -n "$STALE_CNI_CONFS" ]; then
			for _scf in $STALE_CNI_CONFS; do
				say "  stale config: $_scf sets network_backend = \"cni\" -> will comment out"
			done
		fi
	fi

	if [ -x "$NETAVARK_BIN" ]; then
		say "  netavark binary: ok ($NETAVARK_BIN)"
	else
		record_blocker "blocker: netavark binary missing at $NETAVARK_BIN"
		BLOCKERS=$((BLOCKERS + 1))
	fi

	if [ -x "$AARDVARK_BIN" ]; then
		say "  aardvark-dns binary: ok ($AARDVARK_BIN)"
	else
		record_blocker "blocker: aardvark-dns binary missing at $AARDVARK_BIN"
		BLOCKERS=$((BLOCKERS + 1))
	fi

	INOTIFY=$(sysctl -n vfs.inotify.max_user_instances 2>/dev/null || printf 'unknown')
	AARD_VER=$(pkg query '%v' aardvark-dns 2>/dev/null || printf 'unknown')
	if [ "$INOTIFY" = "-1" ]; then
		if [ "$AARD_VER" != "unknown" ] && [ "$(pkg version -t "$AARD_VER" "2.1.0_3")" != "<" ]; then
			record_warn "vfs.inotify.max_user_instances=-1 (covered by aardvark-dns $AARD_VER patch; default is 256)"
			WARNINGS=$((WARNINGS + 1))
		else
			record_blocker "blocker: vfs.inotify.max_user_instances=-1 causes aardvark-dns ($AARD_VER) to abort; set sysctl vfs.inotify.max_user_instances=256 or upgrade aardvark-dns >= 2.1.0_3"
			BLOCKERS=$((BLOCKERS + 1))
		fi
	else
		say "  vfs.inotify.max_user_instances: $INOTIFY (ok)"
	fi

	if [ ! -f "$PF_CONF" ]; then
		record_blocker "blocker: $PF_CONF not found"
		BLOCKERS=$((BLOCKERS + 1))
	elif ! pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
		record_blocker "blocker: pf is not enabled (enable pf before migrating)"
		BLOCKERS=$((BLOCKERS + 1))
	else
		case "$PF_STATUS" in
			OK*)
				say "  pf: enabled; ${PF_STATUS#OK	}"
				;;
			MISSING*)
				say "  pf: enabled; will add to $PF_CONF: ${PF_STATUS#MISSING	}"
				;;
		esac
	fi

	if [ "$FILTER_LOCAL" = "1" ] && [ "$SYSCTL_CONF_OK" -eq 1 ]; then
		say "  net.pf.filter_local: 1 (ok)"
	else
		say "  net.pf.filter_local: $FILTER_LOCAL -> will set 1, add to $SYSCTL_CONF, pf_load=YES in $LOADER_CONF, and reload pf"
	fi

	IP_FWD=$(sysctl -n net.inet.ip.forwarding 2>/dev/null || printf '0')
	if [ "$IP_FWD" = "1" ]; then
		say "  net.inet.ip.forwarding: 1 (ok)"
	else
		say "  net.inet.ip.forwarding: $IP_FWD -> will set 1 and gateway_enable=YES"
	fi

	if [ "$CUR_DNS_PORT" -gt 0 ]; then
		say "  *:53 listener: ${DNS53:-none }(dns_bind_port = $CUR_DNS_PORT already configured in $CUR_DNS_FILE)"
	elif [ -n "$DNS53" ]; then
		say "  *:53 listener: $DNS53-> will set dns_bind_port = $PICK_DNS_PORT in $DNS_CONF_DROPIN"
	else
		say "  *:53 listener: none (aardvark-dns will bind <gateway>:53)"
	fi

	if ! mount 2>/dev/null | grep -q ' on /dev/fd '; then
		record_warn "/dev/fd (fdescfs) is not mounted; container restart policies require fdescfs"
		WARNINGS=$((WARNINGS + 1))
	fi

	LEFTOVER_IFACES=$(leftover_cni_ifaces)
	if [ -n "$LEFTOVER_IFACES" ] && [ "$PMAJOR" -ge 6 ]; then
		say "  leftover CNI interfaces: $(printf '%s' "$LEFTOVER_IFACES" | tr '\n' ' ') (will destroy)"
	fi

	say ""
	say "== Networks ($CNI_DIR) =="
	collect_conflist_files
	NV_NETS_CSV=$(nv_networks_csv)
	CNI_NETS_CSV=""
	if [ -z "$CONFLIST_ARGS" ]; then
		say "  none (built-in default podman network only)"
	else
		IFACES=$(host_ifaces_csv)
		VLAN_BRIDGES=$(vlanfilter_bridges_csv)
		# shellcheck disable=SC2086
		if ! NET_PLAN=$(run_lua conflists "$EPAIR_NV_BIN" "$IFACES" "$VLAN_BRIDGES" "$NV_NETS_CSV" $CONFLIST_ARGS 2>"$WORK_DIR/lua.err"); then
			_le=$(cat "$WORK_DIR/lua.err" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
			record_blocker "failed planning CNI networks${_le:+: $_le}"
			BLOCKERS=$((BLOCKERS + 1))
			return 1
		fi
		OLDIFS=$IFS
		IFS='
'
		for line in $NET_PLAN; do
			tag=${line%%	*}
			rest=${line#*	}
			case "$tag" in
				INFO)
					say "  $rest"
					;;
				CNINET)
					CNI_NETS_CSV="${CNI_NETS_CSV}${rest},"
					;;
				CREATE)
					printf '%s\n' "$rest" >> "$PLAN_CREATE_FILE"
					;;
				CNIBRIDGE)
					printf '%s\n' "$rest" >> "$PLAN_BRIDGES_FILE"
					;;
				NETPLAN)
					_np_name=$(printf '%s' "$rest" | cut -f1)
					_np_from=$(printf '%s' "$rest" | cut -f2)
					_np_to=$(printf '%s' "$rest" | cut -f3)
					_np_res=$(printf '%s' "$rest" | cut -f4)
					_np_err=$(printf '%s' "$rest" | cut -f5-)
					json_add_net "$_np_name" "$_np_from" "$_np_to" "$_np_res" "$_np_err"
					;;
				BLOCKER)
					record_blocker "blocker: $rest"
					BLOCKERS=$((BLOCKERS + 1))
					;;
			esac
		done
		IFS=$OLDIFS
	fi

	HOST_NET_WORK=0
	[ -n "$CONFLIST_ARGS" ] && HOST_NET_WORK=1
	[ -n "$STALE_CNI_CONFS" ] && HOST_NET_WORK=1
	[ -n "$LEFTOVER_IFACES" ] && HOST_NET_WORK=1
	if pgrep -f '/cni/dnsname/' >/dev/null 2>&1; then
		HOST_NET_WORK=1
	fi
	case "$PF_STATUS" in
		MISSING*) HOST_NET_WORK=1 ;;
	esac
	if [ -f "$PF_CONF" ] && pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
		pf_active_anchors_ok || HOST_NET_WORK=1
	fi
	[ "$FILTER_LOCAL" != "1" ] && HOST_NET_WORK=1
	[ "$SYSCTL_CONF_OK" -eq 0 ] && HOST_NET_WORK=1
	[ "$LOADER_CONF_OK" -eq 0 ] && HOST_NET_WORK=1
	[ "$IP_FWD" != "1" ] && HOST_NET_WORK=1
	[ "$DNS_NEEDS_CFG" -eq 1 ] && HOST_NET_WORK=1
	[ "$SVC_MISMATCH" -eq 1 ] && HOST_NET_WORK=1

	say ""
	say "== Containers =="
	P6_CTR_WORK=0
	CIDS=$(pman ps -aq 2>/dev/null || true)
	if [ -z "$CIDS" ]; then
		say "  none"
		: > "$PLAN_INSPECT_FILE"
	else
		PLAN_PSNETS_FILE="$WORK_DIR/psnets"
		pman ps -a --format '{{.Names}}	{{.Networks}}' > "$PLAN_PSNETS_FILE" 2>/dev/null || : > "$PLAN_PSNETS_FILE"
		# shellcheck disable=SC2086
		pman container inspect $CIDS > "$PLAN_INSPECT_FILE" 2>/dev/null || true
		if ! CTR_PLAN=$(run_lua containers "$PLAN_INSPECT_FILE" "$PLAN_RUN_FILE" "$PLAN_RECREATE_FILE" "$PMAJOR" "$CNI_NETS_CSV" "$NV_NETS_CSV" "$PLAN_STOP_NOW_FILE" "$PLAN_PSNETS_FILE" "$HOST_NET_WORK" "$WORK_DIR/autorm" 2>"$WORK_DIR/lua.err"); then
			_le=$(cat "$WORK_DIR/lua.err" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
			record_blocker "failed parsing container inspect output${_le:+: $_le}"
			BLOCKERS=$((BLOCKERS + 1))
			return 1
		fi
		OLDIFS=$IFS
		IFS='
'
		for line in $CTR_PLAN; do
			tag=${line%%	*}
			rest=${line#*	}
			case "$tag" in
				CTR)
					name=$(printf '%s' "$rest" | cut -f1)
					state=$(printf '%s' "$rest" | cut -f2)
					nets=$(printf '%s' "$rest" | cut -f3)
					note=$(printf '%s' "$rest" | cut -f4)
					action=$(printf '%s' "$rest" | cut -f5)
					say "  $name ($state): nets=[$nets] $note -> $action"
					;;
				P6_WORK)
					P6_CTR_WORK="$rest"
					;;
				NEED_RECREATE)
					json_add_list recreate "$rest"
					;;
				WARN)
					record_warn "$rest"
					WARNINGS=$((WARNINGS + 1))
					;;
			esac
		done
		IFS=$OLDIFS
	fi

	if [ "$PMAJOR" -ge 6 ] && [ "$BLOCKERS" -eq 0 ]; then
		NEEDS_P6_MIGRATE="$HOST_NET_WORK"
		[ "$P6_CTR_WORK" -gt 0 ] && NEEDS_P6_MIGRATE=1
		[ "$SVC_MISMATCH" -eq 1 ] && NEEDS_P6_MIGRATE=1
		if [ "$NEEDS_P6_MIGRATE" -eq 0 ]; then
			say ""
			say "  already running on netavark; no unmigrated CNI networks or failed containers"
			return 2
		fi
	fi

	say ""
	say "== Summary =="
	say "  blockers: $BLOCKERS, warnings: $WARNINGS"
	if [ "$BLOCKERS" -gt 0 ]; then
		return 1
	fi
	return 0
}

apply_host_setup() {
	_ah_work="$1"
	_ah_create_pf="${2:-0}"
	_ah_restart_svc="${3:-0}"

	# 1. Pre-mutation checks (leave host unchanged if validation fails).
	if [ ! -f "$PF_CONF" ] && [ "$_ah_create_pf" -ne 1 ]; then
		if [ "$HOST_MUTATED" -eq 1 ]; then
			record_error "$PF_CONF not found"
			json_set_meta pf_status failed
			json_set_meta pf_detail "$PF_CONF not found"
			return 2
		fi
		record_blocker "blocker: $PF_CONF not found"
		json_set_meta pf_status blocked
		json_set_meta pf_detail "$PF_CONF not found"
		return 1
	fi

	_ah_kld_loaded=0
	if kldstat -q -m pf 2>/dev/null; then
		_ah_kld_loaded=1
	else
		if ! kldload -n pf 2>/dev/null; then
			if [ "$HOST_MUTATED" -eq 1 ]; then
				record_error "failed to load pf kernel module"
				json_set_meta pf_status failed
				json_set_meta pf_detail "kldload pf failed"
				return 2
			fi
			record_blocker "blocker: failed to load pf kernel module"
			json_set_meta pf_status blocked
			json_set_meta pf_detail "kldload pf failed"
			return 1
		fi
	fi

	PF_MOD=$(run_lua pf update "$PF_CONF" "$_ah_work/pf.conf.new" "$_ah_create_pf")
	_ah_pf_cand="$PF_CONF"
	case "$PF_MOD" in
		UPDATED*)
			_ah_pf_cand="$_ah_work/pf.conf.new"
			;;
		MISSING*)
			_ah_msg="cannot update $PF_CONF: ${PF_MOD#MISSING	}"
			if [ "$HOST_MUTATED" -eq 1 ]; then
				record_error "$_ah_msg"
				json_set_meta pf_status failed
				json_set_meta pf_detail "$_ah_msg"
				return 2
			fi
			record_blocker "blocker: $_ah_msg"
			json_set_meta pf_status blocked
			json_set_meta pf_detail "$_ah_msg"
			return 1
			;;
	esac

	set +e
	_pf_val_err=$(pfctl -nf "$_ah_pf_cand" 2>&1)
	_pf_val_rc=$?
	set -e
	if [ "$_pf_val_rc" -ne 0 ]; then
		if [ "$HOST_MUTATED" -eq 1 ]; then
			record_error "$PF_CONF syntax check failed: $_pf_val_err"
			json_set_meta pf_status failed
			json_set_meta pf_detail "$_pf_val_err"
			return 2
		fi
		record_blocker "blocker: $PF_CONF syntax check failed: $_pf_val_err"
		json_set_meta pf_status blocked
		json_set_meta pf_detail "$_pf_val_err"
		return 1
	fi

	# Snapshot pre-mutation state for exact changed booleans.
	_ah_fl_live=$(sysctl -n net.pf.filter_local 2>/dev/null || printf '0')
	_ah_fl_conf=0
	if [ -f "$SYSCTL_CONF" ] && grep -Eq '^[[:space:]]*net\.pf\.filter_local[[:space:]]*=[[:space:]]*1([[:space:]]*(#.*)?)?$' "$SYSCTL_CONF"; then
		_ah_fl_conf=1
	fi
	_ah_cur_pfload=$(sysrc -f "$LOADER_CONF" -qn pf_load 2>/dev/null || true)
	_ah_pf_enabled=0
	if pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
		_ah_pf_enabled=1
	fi
	_ah_dns_cur=$(detect_dns_bind_port)
	_ah_dns_port=${_ah_dns_cur%%	*}
	_ah_dns_file=${_ah_dns_cur#*	}
	[ "$_ah_dns_port" != "$_ah_dns_cur" ] || _ah_dns_file=""
	_ah_dns53=$(host_53_listener)

	# 2. sysctl net.pf.filter_local=1 (live + /etc/sysctl.conf)
	_ah_sysctl_changed=0
	_ah_sysctl_live_changed=0
	_ah_sysctl_err=""
	if [ "$_ah_fl_conf" -eq 0 ]; then
		HOST_MUTATED=1
		set +e
		append_sysctl_filter_local 2>"$_ah_work/sysctl.err"
		_rc_sc=$?
		set -e
		if [ "$_rc_sc" -ne 0 ]; then
			_ah_sysctl_err=$(cat "$_ah_work/sysctl.err" 2>/dev/null || printf 'failed writing sysctl.conf')
			record_error "failed updating $SYSCTL_CONF: $_ah_sysctl_err"
			json_set_meta sysctl_changed false
			json_set_meta sysctl_status failed
			json_set_meta sysctl_detail "$_ah_sysctl_err"
			return 2
		fi
		_ah_sysctl_changed=1
	fi
	if [ "$_ah_fl_live" != "1" ]; then
		HOST_MUTATED=1
		set +e
		_sc_out=$(sysctl net.pf.filter_local=1 2>&1 >/dev/null)
		_rc_sl=$?
		set -e
		if [ "$_rc_sl" -ne 0 ]; then
			record_error "failed setting sysctl net.pf.filter_local=1: $_sc_out"
			json_set_meta sysctl_changed false
			json_set_meta sysctl_status failed
			json_set_meta sysctl_detail "$_sc_out"
			return 2
		fi
		_ah_sysctl_changed=1
		_ah_sysctl_live_changed=1
	fi
	if [ "$_ah_sysctl_changed" -eq 1 ]; then
		json_set_meta changed true
		json_set_meta sysctl_changed true
		json_set_meta sysctl_status updated
		say "  sysctl: configured net.pf.filter_local=1"
	else
		json_set_meta sysctl_changed false
		json_set_meta sysctl_status unchanged
		say "  sysctl: net.pf.filter_local=1 already set"
	fi
	json_set_meta sysctl_detail "net.pf.filter_local=1"

	# 3. /boot/loader.conf pf_load="YES"
	_ah_loader_changed=0
	if [ "$_ah_cur_pfload" != "YES" ] && [ "$_ah_cur_pfload" != "yes" ]; then
		HOST_MUTATED=1
		mkdir -p "$(dirname "$LOADER_CONF")"
		set +e
		_ld_out=$(sysrc -f "$LOADER_CONF" pf_load=YES 2>&1 >/dev/null)
		_rc_ld=$?
		set -e
		if [ "$_rc_ld" -ne 0 ]; then
			record_error "failed setting pf_load=YES in $LOADER_CONF: $_ld_out"
			json_set_meta loader_changed false
			json_set_meta loader_status failed
			json_set_meta loader_detail "$_ld_out"
			return 2
		fi
		_ah_loader_changed=1
		json_set_meta changed true
		json_set_meta loader_changed true
		json_set_meta loader_status updated
		say "  loader: set pf_load=YES in $LOADER_CONF"
	else
		json_set_meta loader_changed false
		json_set_meta loader_status unchanged
		say "  loader: pf_load=YES already set in $LOADER_CONF"
	fi
	json_set_meta loader_detail "pf_load=YES in $LOADER_CONF"

	# 4. pf.conf backup, update, enable, and load
	_ah_pf_conf_changed=0
	_ah_pf_enabled_now=0
	_ah_pf_reloaded=0
	case "$PF_MOD" in
		UPDATED*)
			HOST_MUTATED=1
			if [ -f "$PF_CONF" ] && [ ! -f "$BEFORE_FJORD_PF" ] && [ ! -f "$STATE_DIR/pf.conf.pre-netavark" ]; then
				mkdir -p "$STATE_DIR"
				chmod 700 "$STATE_DIR"
				cp "$PF_CONF" "$STATE_DIR/pf.conf.pre-netavark"
			fi
			cp "$_ah_work/pf.conf.new" "$PF_CONF"
			_ah_pf_conf_changed=1
			say "  pf: updated $PF_CONF (${PF_MOD#UPDATED	})"
			;;
	esac

	if [ "$_ah_pf_enabled" -eq 0 ]; then
		HOST_MUTATED=1
		_cur_pfen=$(sysrc -qn pf_enable 2>/dev/null || true)
		if [ "$_cur_pfen" != "YES" ] && [ "$_cur_pfen" != "yes" ]; then
			sysrc pf_enable=YES >/dev/null
		fi
		set +e
		_pfe_out=$(pfctl -e -f "$PF_CONF" 2>&1 >/dev/null)
		_pfe_rc=$?
		set -e
		if [ "$_pfe_rc" -ne 0 ]; then
			if ! pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; then
				record_error "failed enabling pf: $_pfe_out"
				json_set_meta pf_changed false
				json_set_meta pf_status failed
				json_set_meta pf_detail "$_pfe_out"
				return 2
			fi
			pfctl -f "$PF_CONF" >/dev/null
		fi
		_ah_pf_enabled_now=1
		say "  pf: enabled pf and loaded $PF_CONF"
	elif [ "$_ah_sysctl_live_changed" -eq 1 ]; then
		HOST_MUTATED=1
		pfctl -d >/dev/null 2>&1 || true
		set +e
		_pfe_out=$(pfctl -e -f "$PF_CONF" 2>&1 >/dev/null)
		_pfe_rc=$?
		set -e
		if [ "$_pfe_rc" -ne 0 ]; then
			record_error "failed reloading pf after net.pf.filter_local=1: $_pfe_out"
			json_set_meta pf_changed false
			json_set_meta pf_status failed
			json_set_meta pf_detail "$_pfe_out"
			return 2
		fi
		_ah_pf_reloaded=1
		say "  pf: restarted pf for net.pf.filter_local=1"
	elif [ "$_ah_pf_conf_changed" -eq 1 ] || ! pf_active_anchors_ok; then
		HOST_MUTATED=1
		set +e
		_pfe_out=$(pfctl -f "$PF_CONF" 2>&1 >/dev/null)
		_pfe_rc=$?
		set -e
		if [ "$_pfe_rc" -ne 0 ]; then
			record_error "failed loading $PF_CONF: $_pfe_out"
			json_set_meta pf_changed false
			json_set_meta pf_status failed
			json_set_meta pf_detail "$_pfe_out"
			return 2
		fi
		_ah_pf_reloaded=1
		[ "$_ah_pf_conf_changed" -eq 1 ] || say "  pf: loaded active netavark anchors from $PF_CONF"
	fi

	if [ "$_ah_pf_conf_changed" -eq 1 ] || [ "$_ah_pf_enabled_now" -eq 1 ] || [ "$_ah_pf_reloaded" -eq 1 ] || [ "$_ah_kld_loaded" -eq 0 ]; then
		json_set_meta changed true
		json_set_meta pf_changed true
		if [ "$_ah_pf_conf_changed" -eq 1 ]; then
			json_set_meta pf_status updated
			json_set_meta pf_detail "added: ${PF_MOD#UPDATED	}"
		elif [ "$_ah_pf_enabled_now" -eq 1 ]; then
			json_set_meta pf_status enabled
			json_set_meta pf_detail "enabled pf and loaded $PF_CONF"
		else
			json_set_meta pf_status reloaded
			json_set_meta pf_detail "reloaded $PF_CONF"
		fi
	else
		json_set_meta pf_changed false
		json_set_meta pf_status unchanged
		json_set_meta pf_detail "all netavark anchors present and active"
		say "  pf: anchors already present and active"
	fi

	# 5. dns_bind_port when something holds *:53 and not already configured anywhere
	if [ "$_ah_dns_port" -gt 0 ]; then
		json_set_meta dns_changed false
		json_set_meta dns_status already_set
		json_set_meta dns_port "$_ah_dns_port"
		json_set_meta dns_file "$_ah_dns_file"
		say "  dns_bind_port: already configured ($_ah_dns_port in $_ah_dns_file)"
	elif [ -n "$_ah_dns53" ]; then
		HOST_MUTATED=1
		_pick_port=$(free_dns_port)
		mkdir -p "$(dirname "$DNS_CONF_DROPIN")"
		cat > "$DNS_CONF_DROPIN" <<EOF
[network]
dns_bind_port = $_pick_port
EOF
		json_set_meta changed true
		json_set_meta dns_changed true
		json_set_meta dns_status updated
		json_set_meta dns_port "$_pick_port"
		json_set_meta dns_file "$DNS_CONF_DROPIN"
		say "  dns_bind_port: wrote dns_bind_port = $_pick_port to $DNS_CONF_DROPIN (*:53 held by $_ah_dns53)"
		if [ "$_ah_restart_svc" -eq 1 ] && service podman_service status >/dev/null 2>&1; then
			_svc_now=$(service_backend_of)
			_cli_now=$(backend_of)
			if [ "$_svc_now" = "$_cli_now" ]; then
				say "  restarting podman_service"
				if ! service podman_service restart >/dev/null 2>&1; then
					record_warn "failed to restart podman_service after writing $DNS_CONF_DROPIN"
				fi
			elif [ -n "$_svc_now" ]; then
				record_warn "running podman_service uses '$_svc_now' while configuration selects '$_cli_now'; skipping service restart during 'host'"
			fi
		fi
	else
		json_set_meta dns_changed false
		json_set_meta dns_status unchanged
		json_set_meta dns_port "53"
		json_set_meta dns_file ""
		say "  dns_bind_port: *:53 is free (no override needed)"
	fi

	HOST_CHANGED=0
	if [ "$_ah_sysctl_changed" -eq 1 ] || [ "$_ah_loader_changed" -eq 1 ] || \
	   [ "$_ah_pf_conf_changed" -eq 1 ] || [ "$_ah_pf_enabled_now" -eq 1 ] || \
	   [ "$_ah_pf_reloaded" -eq 1 ] || [ "$_ah_kld_loaded" -eq 0 ] || \
	   { [ "$_ah_dns_port" -eq 0 ] && [ -n "$_ah_dns53" ]; }; then
		HOST_CHANGED=1
	fi
	return 0
}

cmd_check() {
	TMPD="$JSON_DIR/check"
	mkdir -p "$TMPD"
	set +e
	run_preflight "$TMPD/create" "$TMPD/bridges" "$TMPD/running" "$TMPD/recreate" "$TMPD/inspect" "$TMPD/stop_now"
	rc=$?
	set -e
	if [ "$rc" -eq 2 ]; then
		finish_rc 0
	fi
	if [ "$rc" -eq 0 ] && [ "${SVC_MISMATCH:-0}" -eq 1 ]; then
		record_blocker "running podman_service uses '${SVC_BACKEND:-unknown}' while configuration selects '${BACKEND:-unknown}'; fix: service podman_service restart"
		finish_rc 1
	fi
	if [ "$rc" -ne 0 ]; then
		finish_rc 1
	fi
	finish_rc 0
}

cmd_host() {
	require_root
	TMPD="$JSON_DIR/host"
	mkdir -p "$TMPD"

	BE_BEFORE=$(backend_of)
	SVC_BEFORE=$(service_backend_of)
	json_set_meta backend_changed false
	json_set_meta backend_from "$BE_BEFORE"
	json_set_meta backend_to "$BE_BEFORE"
	json_set_meta backend_service "$SVC_BEFORE"

	say "== Host setup for netavark =="
	if [ -n "$SVC_BEFORE" ] && [ "$SVC_BEFORE" != "$BE_BEFORE" ]; then
		record_warn "running podman_service uses '$SVC_BEFORE' while configuration selects '$BE_BEFORE'"
	fi

	set +e
	apply_host_setup "$TMPD" 1 1
	_ah_rc=$?
	set -e

	SVC_AFTER=$(service_backend_of)
	[ -n "$SVC_AFTER" ] && json_set_meta backend_service "$SVC_AFTER"

	if [ "$_ah_rc" -eq 1 ]; then
		err "host setup refused; host left unchanged"
		finish_rc 1
	elif [ "$_ah_rc" -ne 0 ]; then
		err "host setup failed after modifying host state"
		finish_rc 2
	fi

	if [ "$HOST_CHANGED" -eq 0 ]; then
		say "Nothing changed: host is already configured for netavark."
	else
		say "Host setup complete."
	fi
	finish_rc 0
}

cmd_switch() {
	require_root
	TMPD="$JSON_DIR/switch"
	mkdir -p "$TMPD"

	set +e
	run_preflight "$TMPD/create" "$TMPD/bridges" "$TMPD/running" "$TMPD/recreate" "$TMPD/inspect" "$TMPD/stop_now"
	rc=$?
	set -e
	if [ "$rc" -eq 2 ]; then
		say "Nothing to do: already on netavark."
		finish_rc 0
	elif [ "$rc" -ne 0 ]; then
		err "preflight failed; host left unchanged"
		finish_rc 1
	fi

	say ""
	say "== Migrating CNI -> netavark =="

	HOST_MUTATED=1
	json_set_meta changed true

	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"
	mkdir -p "$STATE_DIR/cni-net.d"
	cp "$TMPD/running" "$STATE_DIR/running-containers.txt"
	cp "$TMPD/inspect" "$STATE_DIR/containers-inspect.json"
	if [ -f "$TMPD/recreate" ]; then
		cp "$TMPD/recreate" "$STATE_DIR/recreate-commands.sh"
		chmod 700 "$STATE_DIR/recreate-commands.sh"
	fi

	FAILURES=0

	# 1. Stop running containers (under CNI on Podman 5, or pre-upgrade CNI / pre-PF jails on Podman 6).
	if [ -s "$TMPD/stop_now" ]; then
		if [ "$PMAJOR" -lt 6 ]; then
			stop_running_ctrs "$TMPD/stop_now" "$TMPD/stop.err" "on CNI" || true
			wait_autoremove_ctrs "$TMPD/autorm"
		else
			STOP_LIST=$(tr '\n' ' ' < "$TMPD/stop_now")
			say "  stopping currently running containers: $STOP_LIST"
			for _sc in $(cat "$TMPD/stop_now"); do
				ctr_exists "$_sc" || continue
				ctr_running "$_sc" || continue
				pman stop -i -t 10 "$_sc" >/dev/null 2>&1 || true
				# Fallback if pre-upgrade CNI network teardown failed after stopping or before stopping jail
				if ctr_running "$_sc"; then
					_cid=$(pman inspect --format '{{.Id}}' "$_sc" 2>/dev/null || printf '')
					if [ -n "$_cid" ]; then
						pkill -f "$_cid" 2>/dev/null || true
						jail -r "$_cid" 2>/dev/null || true
					fi
				fi
			done
			wait_autoremove_ctrs "$TMPD/autorm"
		fi
	fi

	# 2. Stop leftover CNI dnsname dnsmasq, CNI epair interfaces, and CNI bridges.
	pkill -f '/cni/dnsname/' 2>/dev/null || true
	if [ -d "$CNI_EPAIR_STATE_DIR" ]; then
		for _ef in "$CNI_EPAIR_STATE_DIR"/*; do
			[ -f "$_ef" ] || continue
			case "$_ef" in
				*.gw)
					rm -f "$_ef"
					continue
					;;
			esac
			while read -r _c1 _c2; do
				_ep="${_c2:-$_c1}"
				[ -n "$_ep" ] || continue
				if ifconfig "$_ep" >/dev/null 2>&1; then
					say "  destroying CNI epair $_ep"
					ifconfig "$_ep" destroy 2>/dev/null || true
				fi
			done < "$_ef"
			rm -f "$_ef"
		done
	fi
	for _ep in $(ifconfig -g epair 2>/dev/null | grep -E '^(vnet|eth[0-9])' || true); do
		if ifconfig "$_ep" >/dev/null 2>&1; then
			say "  destroying leftover CNI epair $_ep"
			ifconfig "$_ep" destroy 2>/dev/null || true
		fi
	done
	ALL_CNI_BRIDGES=$( { ifconfig -l | tr ' ' '\n' | grep '^cni-podman' || true; cat "$TMPD/bridges"; if [ "$PMAJOR" -ge 6 ]; then ifconfig -l | tr ' ' '\n' | grep '^podman[0-9]' || true; fi; } | sort -u )
	for br in $ALL_CNI_BRIDGES; do
		if ifconfig "$br" >/dev/null 2>&1; then
			say "  destroying CNI/stale bridge $br"
			ifconfig "$br" destroy 2>/dev/null || true
		fi
	done

	# 3. Back up and move CNI conflists out of cni/net.d.
	collect_conflist_files
	if [ -n "$CONFLIST_ARGS" ]; then
		# shellcheck disable=SC2086
		for f in $CONFLIST_ARGS; do
			mv "$f" "$STATE_DIR/cni-net.d/"
		done
	fi

	# 4. Clear stale network_backend="cni" configs (on Podman 6) and write netavark backend drop-in.
	if [ -n "$STALE_CNI_CONFS" ]; then
		mkdir -p "$STATE_DIR/containers-conf.bak"
		for _scf in $STALE_CNI_CONFS; do
			cp "$_scf" "$STATE_DIR/containers-conf.bak/$(basename "$_scf")"
			sed -i '' -E 's/^([[:space:]]*network_backend[[:space:]]*=[[:space:]]*"cni".*)$/# \1 # disabled by netavark-migrate/' "$_scf"
			say "  commented out network_backend=\"cni\" in $_scf"
		done
		PODMAN_CONF_OVERRIDE=""
	fi
	mkdir -p "$(dirname "$CONF_DROPIN")"
	cat > "$CONF_DROPIN" <<'EOF'
[network]
network_backend = "netavark"
EOF
	say "  wrote $CONF_DROPIN (network_backend=netavark)"

	# 5. Apply host setup (pf, filter_local, pf_load, dns_bind_port), forwarding, and restart podman_service.
	set +e
	apply_host_setup "$TMPD" 0 0
	_hs_rc=$?
	set -e
	if [ "$_hs_rc" -ne 0 ]; then
		FAILURES=$((FAILURES + 1))
	fi

	if [ "$(sysctl -n net.inet.ip.forwarding 2>/dev/null || printf 0)" != "1" ]; then
		sysctl net.inet.ip.forwarding=1 >/dev/null || FAILURES=$((FAILURES + 1))
	fi
	if [ "$(sysrc -qn gateway_enable 2>/dev/null || true)" != "YES" ]; then
		sysrc gateway_enable=YES >/dev/null || true
	fi

	if service podman_service status >/dev/null 2>&1; then
		say "  restarting podman_service"
		if ! service podman_service restart >/dev/null 2>&1; then
			record_error "failed restarting podman_service"
			FAILURES=$((FAILURES + 1))
		fi
	fi

	NEW_BACKEND=$(backend_of)
	SVC_AFTER=$(service_backend_of)
	json_set_meta backend_to "$NEW_BACKEND"
	json_set_meta backend_service "$SVC_AFTER"
	if [ "$BACKEND" != "$NEW_BACKEND" ]; then
		json_set_meta backend_changed true
	fi
	if [ "$NEW_BACKEND" != "netavark" ]; then
		record_error "Podman reports backend '$NEW_BACKEND' instead of 'netavark'"
		finish_rc 2
	fi

	# 6. Recreate custom networks under netavark.
	if [ -s "$TMPD/create" ]; then
		OLDIFS=$IFS
		IFS='
'
		for row in $(cat "$TMPD/create"); do
			IFS=$OLDIFS
			net_name=$(printf '%s' "$row" | cut -f1)
			net_kind=$(printf '%s' "$row" | cut -f2)
			net_cmd=$(printf '%s' "$row" | cut -f3-)
			say "  creating network $net_name ($net_kind)"
			set +e
			_nc_err=$(eval "$net_cmd" 2>&1 >/dev/null)
			_nc_rc=$?
			set -e
			if [ "$_nc_rc" -ne 0 ]; then
				_nc_msg=$(printf '%s' "$_nc_err" | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
				[ -n "$_nc_msg" ] || _nc_msg="podman network create exited $_nc_rc"
				record_error "failed to create network $net_name: $_nc_msg"
				json_add_net "$net_name" "" "$net_kind" "failed" "$_nc_msg"
				FAILURES=$((FAILURES + 1))
			else
				json_add_net "$net_name" "" "$net_kind" "created" ""
			fi
		done
		IFS=$OLDIFS
	fi

	# 7. Start containers in place unless --no-start was requested.
	if [ "$NO_START" -eq 1 ]; then
		say "  --no-start: leaving containers stopped for recreation"
		if [ -s "$STATE_DIR/running-containers.txt" ]; then
			for cname in $(cat "$STATE_DIR/running-containers.txt"); do
				ctr_exists "$cname" || continue
				json_add_list recreate "$cname"
				say "  container $cname: needs recreating / starting under netavark"
			done
		fi
	elif [ -s "$STATE_DIR/running-containers.txt" ]; then
		for cname in $(cat "$STATE_DIR/running-containers.txt"); do
			ctr_exists "$cname" || continue
			say "  starting container $cname"
			set +e
			_st_err=$(podman start "$cname" 2>&1 >/dev/null)
			_st_rc=$?
			set -e
			if [ "$_st_rc" -ne 0 ]; then
				ctr_exists "$cname" || continue
				_st_msg=$(printf '%s' "$_st_err" | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
				[ -n "$_st_msg" ] || _st_msg="podman start exited $_st_rc"
				record_error "failed to start container $cname: $_st_msg (fallback run command in $STATE_DIR/recreate-commands.sh)"
				json_add_list failed_ctrs "$cname"
				json_add_list recreate "$cname"
				FAILURES=$((FAILURES + 1))
			fi
		done
	fi

	say ""
	say "== Verification =="
	say "  backend: $(backend_of)"
	say "  net.pf.filter_local: $(sysctl -n net.pf.filter_local 2>/dev/null || printf unknown)"
	say "  networks: $(podman network ls --format '{{.Name}}({{.Driver}})' | tr '\n' ' ')"
	if [ "$NO_START" -eq 0 ] && [ -s "$STATE_DIR/running-containers.txt" ]; then
		for cname in $(cat "$STATE_DIR/running-containers.txt"); do
			ctr_exists "$cname" || continue
			if grep -qxF "$cname" "$JSON_STATE/failed_ctrs.txt" 2>/dev/null; then
				continue
			fi
			st=$(podman inspect --format '{{.State.Running}}' "$cname" 2>/dev/null || printf false)
			ips=""
			if [ "$st" = "true" ]; then
				ips=$(podman exec "$cname" ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" { printf "%s ", $2 }' || true)
				json_add_list started "$cname"
			else
				record_error "container $cname is not running after start (state=$st)"
				json_add_list failed_ctrs "$cname"
				json_add_list recreate "$cname"
				FAILURES=$((FAILURES + 1))
			fi
			say "  container $cname: running=$st ips=[${ips% }]"
		done
	fi
	if [ "$PMAJOR" -ge 6 ]; then
		say "  archived CNI conflists under $STATE_DIR (Podman 6 removed CNI; rollback requires Podman 5)"
	else
		say "  rollback saved under $STATE_DIR (use 'netavark-migrate back' to revert to CNI)"
	fi

	if [ "$FAILURES" -gt 0 ]; then
		err "completed with $FAILURES failure(s)"
		finish_rc 2
	fi
	say "Migration complete."
	finish_rc 0
}

cmd_back() {
	require_root
	TMPD="$JSON_DIR/back"
	mkdir -p "$TMPD"

	PVER_B=$(podman_version)
	BE_BEFORE=$(backend_of)
	SVC_BEFORE=$(service_backend_of)
	json_set_meta backend_changed false
	json_set_meta backend_from "$BE_BEFORE"
	json_set_meta backend_to "cni"
	json_set_meta backend_service "$SVC_BEFORE"

	if [ "$(podman_major)" -ge 6 ]; then
		json_set_meta backend_to "$BE_BEFORE"
		record_blocker "Podman $PVER_B does not support the CNI backend; downgrade to Podman 5 before running 'netavark-migrate back'"
		finish_rc 1
	fi

	# Nothing to do if already cleanly on CNI with no netavark state/drop-in to revert.
	_has_cni_bak=0
	if [ -d "$STATE_DIR/cni-net.d" ] && [ -n "$(find "$STATE_DIR/cni-net.d" -maxdepth 1 -type f 2>/dev/null || true)" ]; then
		_has_cni_bak=1
	fi
	_has_before_cni=0
	if [ -d "$BEFORE_CNI_DIR" ] && [ -n "$(find "$BEFORE_CNI_DIR" -maxdepth 1 \( -name '*.conflist' -o -name '*.conf' \) 2>/dev/null || true)" ]; then
		_has_before_cni=1
	fi
	_has_nv_nets=0
	if [ -d "$NV_NET_DIR" ] && [ -n "$(find "$NV_NET_DIR" -maxdepth 1 -name '*.json' 2>/dev/null || true)" ]; then
		_has_nv_nets=1
	fi
	_stale_nv=$(stale_backend_conf_files netavark)
	if [ "$BE_BEFORE" = "cni" ] && { [ -z "$SVC_BEFORE" ] || [ "$SVC_BEFORE" = "cni" ]; } && \
	   [ ! -f "$CONF_DROPIN" ] && [ -z "$_stale_nv" ] && \
	   [ "$_has_cni_bak" -eq 0 ] && [ "$_has_before_cni" -eq 0 ] && [ "$_has_nv_nets" -eq 0 ]; then
		say "Nothing to do: already on CNI."
		finish_rc 0
	fi

	say "== Rolling back netavark -> CNI =="
	BACK_TMP="$TMPD"
	HOST_MUTATED=1
	json_set_meta changed true

	HAD_SWITCH_STATE=0
	if [ -f "$STATE_DIR/running-containers.txt" ]; then
		HAD_SWITCH_STATE=1
	fi

	CUR_RUNNING=$(podman ps --format '{{.Names}}' 2>/dev/null || true)
	BACK_CIDS=$(podman ps -aq 2>/dev/null || true)
	if [ -n "$BACK_CIDS" ]; then
		podman ps -a --format '{{.Names}}	{{.Networks}}' > "$BACK_TMP/psnets" 2>/dev/null || : > "$BACK_TMP/psnets"
		# shellcheck disable=SC2086
		podman container inspect $BACK_CIDS > "$BACK_TMP/inspect.json" 2>/dev/null || true
		run_lua ctrnets "$BACK_TMP/inspect.json" "$BACK_TMP/psnets" > "$BACK_TMP/ctrnets.tsv"
	else
		: > "$BACK_TMP/ctrnets.tsv"
	fi
	if [ -f "$STATE_DIR/containers-inspect.json" ]; then
		run_lua ctrnets "$STATE_DIR/containers-inspect.json" "" | cut -f1 > "$BACK_TMP/pre_switch_ctrs.txt"
	else
		: > "$BACK_TMP/pre_switch_ctrs.txt"
	fi

	FAILURES=0

	# 1. Stop running containers under netavark so aardvark/pf teardown runs cleanly.
	printf '%s\n' "$CUR_RUNNING" | sed '/^$/d' > "$BACK_TMP/running-back-raw.txt"
	awk -F '\t' '$4 == "true" { print $1 }' "$BACK_TMP/ctrnets.tsv" > "$BACK_TMP/autorm.txt"
	if [ -s "$BACK_TMP/running-back-raw.txt" ]; then
		for _rbc in $(cat "$BACK_TMP/running-back-raw.txt"); do
			if ! grep -qxF "$_rbc" "$BACK_TMP/autorm.txt" 2>/dev/null && ctr_autoremove "$_rbc"; then
				printf '%s\n' "$_rbc" >> "$BACK_TMP/autorm.txt"
			fi
		done
	fi
	stop_running_ctrs "$BACK_TMP/running-back-raw.txt" "$BACK_TMP/stop.err" "on netavark" || true
	wait_autoremove_ctrs "$BACK_TMP/autorm.txt"
	: > "$BACK_TMP/running-back.txt"
	if [ -s "$BACK_TMP/running-back-raw.txt" ]; then
		for _rbc in $(cat "$BACK_TMP/running-back-raw.txt"); do
			grep -qxF "$_rbc" "$BACK_TMP/autorm.txt" 2>/dev/null && continue
			ctr_exists "$_rbc" || continue
			printf '%s\n' "$_rbc" >> "$BACK_TMP/running-back.txt"
		done
	fi

	# 2. Stop aardvark-dns and destroy netavark podman[0-9]* bridges.
	pkill -x aardvark-dns 2>/dev/null || true
	for br in $(ifconfig -l | tr ' ' '\n' | grep '^podman[0-9]' || true); do
		if ifconfig "$br" >/dev/null 2>&1; then
			say "  destroying netavark bridge $br"
			ifconfig "$br" destroy 2>/dev/null || true
		fi
	done

	# 3. Restore CNI conflists from $STATE_DIR/cni-net.d first, then ${CNI_DIR}.before-netavark
	# (skipping any network name already present or restored).
	RESTORED_CNI_NAMES=""
	mkdir -p "$CNI_DIR"
	for f in "$CNI_DIR"/*.conflist "$CNI_DIR"/*.conf; do
		[ -f "$f" ] || continue
		_n=$(run_lua jsonname "$f")
		RESTORED_CNI_NAMES="${RESTORED_CNI_NAMES:+${RESTORED_CNI_NAMES},}$_n"
	done
	if [ -d "$STATE_DIR/cni-net.d" ]; then
		for f in "$STATE_DIR/cni-net.d"/*; do
			[ -f "$f" ] || continue
			_n=$(run_lua jsonname "$f")
			_b=$(basename "$f")
			mv "$f" "$CNI_DIR/$_b"
			if ! has_csv_token "$RESTORED_CNI_NAMES" "$_n"; then
				RESTORED_CNI_NAMES="${RESTORED_CNI_NAMES:+${RESTORED_CNI_NAMES},}$_n"
			fi
			json_add_net "$_n" "netavark" "cni" "restored" ""
			say "  restored CNI conflist $_b (network $_n)"
		done
	fi
	if [ -d "$BEFORE_CNI_DIR" ]; then
		for f in "$BEFORE_CNI_DIR"/*.conflist "$BEFORE_CNI_DIR"/*.conf; do
			[ -f "$f" ] || continue
			_n=$(run_lua jsonname "$f")
			_b=$(basename "$f")
			if has_csv_token "$RESTORED_CNI_NAMES" "$_n" || [ -e "$CNI_DIR/$_b" ]; then
				if ! has_csv_token "$RESTORED_CNI_NAMES" "$_n"; then
					json_add_net "$_n" "before-netavark" "cni" "skipped_duplicate" ""
				fi
				say "  skipping $_b from $BEFORE_CNI_DIR (network $_n already restored)"
				continue
			fi
			mv "$f" "$CNI_DIR/$_b"
			RESTORED_CNI_NAMES="${RESTORED_CNI_NAMES:+${RESTORED_CNI_NAMES},}$_n"
			json_add_net "$_n" "before-netavark" "cni" "restored" ""
			say "  restored CNI conflist $_b (network $_n) from $BEFORE_CNI_DIR"
		done
		rmdir "$BEFORE_CNI_DIR" 2>/dev/null || true
	fi

	# 4. Keep only netavark-only network JSONs (those without a CNI conflist to restore)
	# in $STATE_DIR/netavark-networks.bak with their names unchanged for fjord carry-back.
	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"
	rm -rf "$STATE_DIR/netavark-networks.bak"
	mkdir -p "$STATE_DIR/netavark-networks.bak"
	KEPT_NV_NETS=""
	if [ -d "$NV_NET_DIR" ]; then
		for j in "$NV_NET_DIR"/*.json; do
			[ -f "$j" ] || continue
			_n=$(run_lua jsonname "$j")
			_fn=$(basename "$j")
			if [ "$_n" = "podman" ] || has_csv_token "$RESTORED_CNI_NAMES" "$_n"; then
				rm -f "$j"
			else
				mv "$j" "$STATE_DIR/netavark-networks.bak/$_fn"
				KEPT_NV_NETS="${KEPT_NV_NETS}${KEPT_NV_NETS:+ }$_n"
				json_add_list kept_nv "$_n"
				json_add_net "$_n" "netavark" "netavark-networks.bak" "kept_for_recreate" ""
			fi
		done
	fi
	if [ -n "$KEPT_NV_NETS" ]; then
		say "  kept netavark networks without CNI conflists in $STATE_DIR/netavark-networks.bak: $KEPT_NV_NETS"
	else
		say "  kept netavark networks without CNI conflists: none"
	fi

	# 5. Remove drop-in / netavark backend overrides and confirm CNI backend.
	rm -f "$CONF_DROPIN"
	STALE_NV_CONFS=$(stale_backend_conf_files netavark)
	if [ -n "$STALE_NV_CONFS" ]; then
		mkdir -p "$STATE_DIR/containers-conf-back.bak"
		for _nvcf in $STALE_NV_CONFS; do
			cp "$_nvcf" "$STATE_DIR/containers-conf-back.bak/$(basename "$_nvcf")"
			sed -i '' -E 's/^([[:space:]]*network_backend[[:space:]]*=[[:space:]]*"netavark".*)$/# \1 # disabled by netavark-migrate back/' "$_nvcf"
			say "  commented out network_backend=\"netavark\" in $_nvcf"
		done
	fi
	if service podman_service status >/dev/null 2>&1; then
		say "  restarting podman_service"
		if ! service podman_service restart >/dev/null 2>&1; then
			record_error "failed restarting podman_service"
			FAILURES=$((FAILURES + 1))
		fi
	fi

	BACK=$(backend_of)
	SVC_AFTER=$(service_backend_of)
	json_set_meta backend_to "$BACK"
	json_set_meta backend_service "$SVC_AFTER"
	if [ "$BE_BEFORE" != "$BACK" ]; then
		json_set_meta backend_changed true
	fi
	if [ "$BACK" != "cni" ]; then
		record_error "expected backend 'cni' after removing $CONF_DROPIN, got '$BACK'"
		finish_rc 2
	fi

	# 6. Restart pre-switch CNI containers unless --no-start was given; otherwise only report recreation list.
	STARTED_CTRS=""
	RECREATE_CTRS=""
	if [ "$NO_START" -eq 1 ]; then
		say "  --no-start: leaving containers stopped for recreation"
		if [ "$HAD_SWITCH_STATE" -eq 1 ]; then
			cp "$BACK_TMP/running-back.txt" "$STATE_DIR/running-containers-back.txt"
			START_FILE="$STATE_DIR/running-containers-back.txt"
			[ -s "$START_FILE" ] || START_FILE="$STATE_DIR/running-containers.txt"
			if [ -s "$START_FILE" ]; then
				for cname in $(cat "$START_FILE"); do
					grep -qxF "$cname" "$BACK_TMP/autorm.txt" 2>/dev/null && continue
					ctr_exists "$cname" || continue
					case " $RECREATE_CTRS " in
						*" $cname "*) continue ;;
					esac
					RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${cname}"
					json_add_list recreate "$cname"
				done
			fi
		fi
		while IFS='	' read -r _acname _arun _acnets _aautorm; do
			[ -n "$_acname" ] || continue
			[ "$_aautorm" = "true" ] && continue
			ctr_exists "$_acname" || continue
			case " $RECREATE_CTRS " in
				*" $_acname "*) continue ;;
			esac
			_add_rec=0
			if [ "$HAD_SWITCH_STATE" -eq 0 ]; then
				_add_rec=1
			else
				for _kn in $KEPT_NV_NETS; do
					if has_csv_token "$_acnets" "$_kn"; then
						_add_rec=1
						break
					fi
				done
				if [ "$_add_rec" -eq 0 ] && ! grep -qxF "$_acname" "$BACK_TMP/pre_switch_ctrs.txt" 2>/dev/null; then
					_add_rec=1
				fi
			fi
			if [ "$_add_rec" -eq 1 ]; then
				RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${_acname}"
				json_add_list recreate "$_acname"
			fi
		done < "$BACK_TMP/ctrnets.tsv"
	elif [ "$HAD_SWITCH_STATE" -eq 1 ]; then
		cp "$BACK_TMP/running-back.txt" "$STATE_DIR/running-containers-back.txt"
		START_FILE="$STATE_DIR/running-containers-back.txt"
		[ -s "$START_FILE" ] || START_FILE="$STATE_DIR/running-containers.txt"
		if [ -s "$START_FILE" ]; then
			for cname in $(cat "$START_FILE"); do
				grep -qxF "$cname" "$BACK_TMP/autorm.txt" 2>/dev/null && continue
				ctr_exists "$cname" || continue
				_cnets=$(awk -F '\t' -v c="$cname" '$1 == c { print $3; exit }' "$BACK_TMP/ctrnets.tsv")
				_uses_kept=0
				for _kn in $KEPT_NV_NETS; do
					if has_csv_token "$_cnets" "$_kn"; then
						_uses_kept=1
						break
					fi
				done
				if [ "$_uses_kept" -eq 1 ]; then
					say "  container $cname needs recreating on CNI (uses netavark-only network)"
					RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${cname}"
					json_add_list recreate "$cname"
					continue
				fi
				say "  starting container $cname on CNI"
				set +e
				_bs_err=$(podman start "$cname" 2>&1 >/dev/null)
				_bs_rc=$?
				set -e
				if [ "$_bs_rc" -eq 0 ]; then
					STARTED_CTRS="${STARTED_CTRS}${STARTED_CTRS:+ }${cname}"
				elif ! ctr_exists "$cname"; then
					continue
				elif ! grep -qxF "$cname" "$BACK_TMP/pre_switch_ctrs.txt" 2>/dev/null; then
					say "  container $cname needs recreating on CNI (created on netavark)"
					RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${cname}"
					json_add_list recreate "$cname"
				else
					_bs_msg=$(printf '%s' "$_bs_err" | tr '\n' ' ' | sed 's/  */ /g; s/[[:space:]]*$//')
					[ -n "$_bs_msg" ] || _bs_msg="podman start exited $_bs_rc"
					record_error "failed to start container $cname on CNI: $_bs_msg"
					json_add_list failed_ctrs "$cname"
					json_add_list recreate "$cname"
					FAILURES=$((FAILURES + 1))
				fi
			done
		fi
		# Also report any remaining container attached to a kept netavark-only network.
		while IFS='	' read -r _acname _arun _acnets _aautorm; do
			[ -n "$_acname" ] || continue
			[ "$_aautorm" = "true" ] && continue
			ctr_exists "$_acname" || continue
			case " $RECREATE_CTRS " in
				*" $_acname "*) continue ;;
			esac
			for _kn in $KEPT_NV_NETS; do
				if has_csv_token "$_acnets" "$_kn"; then
					say "  container $_acname needs recreating on CNI (uses netavark-only network $_kn)"
					RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${_acname}"
					json_add_list recreate "$_acname"
					break
				fi
			done
		done < "$BACK_TMP/ctrnets.tsv"
	else
		say "  no running-containers list in $STATE_DIR; restored networks and backend only"
		while IFS='	' read -r _acname _arun _acnets _aautorm; do
			[ -n "$_acname" ] || continue
			[ "$_aautorm" = "true" ] && continue
			ctr_exists "$_acname" || continue
			RECREATE_CTRS="${RECREATE_CTRS}${RECREATE_CTRS:+ }${_acname}"
			json_add_list recreate "$_acname"
		done < "$BACK_TMP/ctrnets.tsv"
	fi

	say ""
	say "== Rollback verification =="
	say "  backend: $(backend_of)"
	say "  networks: $(podman network ls --format '{{.Name}}({{.Driver}})' | tr '\n' ' ')"
	say "  kept netavark networks ($STATE_DIR/netavark-networks.bak): ${KEPT_NV_NETS:-none}"
	say "  containers needing recreation on CNI: ${RECREATE_CTRS:-none}"
	if [ -n "$STARTED_CTRS" ]; then
		for cname in $STARTED_CTRS; do
			ctr_exists "$cname" || continue
			st=$(podman inspect --format '{{.State.Running}}' "$cname" 2>/dev/null || printf false)
			ips=""
			if [ "$st" = "true" ]; then
				ips=$(podman exec "$cname" ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" { printf "%s ", $2 }' || true)
				json_add_list started "$cname"
			else
				record_error "container $cname is not running after start on CNI (state=$st)"
				json_add_list failed_ctrs "$cname"
				json_add_list recreate "$cname"
				FAILURES=$((FAILURES + 1))
			fi
			say "  container $cname: running=$st ips=[${ips% }]"
		done
	fi
	if [ -f "$BEFORE_FJORD_PF" ]; then
		say "  pre-fjord pf.conf copy kept at $BEFORE_FJORD_PF"
	elif [ -f "$STATE_DIR/pf.conf.pre-netavark" ]; then
		say "  pre-migration pf.conf copy kept at $STATE_DIR/pf.conf.pre-netavark"
	fi

	if [ "$FAILURES" -gt 0 ]; then
		err "rollback completed with $FAILURES failure(s)"
		finish_rc 2
	fi
	say "Rollback complete."
	finish_rc 0
}

ACTION=""
ARG_ERR=""
for _arg in "$@"; do
	case "$_arg" in
		--json)
			JSON_MODE=1
			;;
		--no-start)
			NO_START=1
			;;
		version|--version|-V)
			if [ -n "$ACTION" ] && [ "$ACTION" != "version" ]; then
				ARG_ERR="conflicting subcommands: $ACTION and $_arg"
			else
				ACTION="version"
			fi
			;;
		-h|--help|help)
			if [ -n "$ACTION" ] && [ "$ACTION" != "help" ]; then
				ARG_ERR="conflicting subcommands: $ACTION and $_arg"
			else
				ACTION="help"
			fi
			;;
		check|host|switch|back)
			if [ -n "$ACTION" ] && [ "$ACTION" != "$_arg" ]; then
				ARG_ERR="conflicting subcommands: $ACTION and $_arg"
			else
				ACTION="$_arg"
			fi
			;;
		*)
			ARG_ERR="unknown argument: $_arg"
			;;
	esac
done

[ -n "$ACTION" ] || ACTION="switch"

if [ "$ACTION" = "version" ] && [ -z "$ARG_ERR" ] && [ "$NO_START" -eq 0 ]; then
	printf 'netavark-migrate %s %s\n' "$INTERFACE_VERSION" "$INTERFACE_CAPS"
	exit 0
fi

if [ "$ACTION" = "help" ] && [ -z "$ARG_ERR" ]; then
	usage
	exit 0
fi

if [ -z "$ARG_ERR" ] && [ "$NO_START" -eq 1 ] && [ "$ACTION" != "switch" ] && [ "$ACTION" != "back" ]; then
	ARG_ERR="--no-start is only valid with switch or back"
fi

if [ "$JSON_MODE" -eq 1 ]; then
	exec 3>&1 1>&2
fi

json_init
trap 'cleanup_on_exit' EXIT

if [ -n "$ARG_ERR" ]; then
	record_blocker "$ARG_ERR"
	usage >&2
	finish_rc 1
fi

case "$ACTION" in
	check)
		cmd_check
		;;
	host)
		cmd_host
		;;
	switch)
		cmd_switch
		;;
	back)
		cmd_back
		;;
esac
